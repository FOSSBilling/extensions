---
import Base from '../../layouts/Base.astro';
import CatalogueSection from '@/components/CatalogueSection.astro';
import { getDeveloperById } from '@/lib/extensions-data';
import {
  ApiRequestError,
  createApiClient,
  getApiErrorMessage,
  listExtensions,
  type ExtensionListResponse,
} from '@/lib/api/client';
import { hasNextPage } from '@/lib/catalogue-pagination';
import { getSessionUser } from '@/lib/session';
import { requireUser } from '@/lib/auth-guard';
import { formString } from '@/lib/form';
import { isSafeHttpUrl } from '@/lib/safe-url';
import { CircleAlert } from '@lucide/astro';
import ProfileTrustBadge from '@/components/ProfileTrustBadge.astro';
import DeveloperAvatar from '@/components/DeveloperAvatar.astro';

const env = Astro.locals.env;
const { id } = Astro.params;

if (!id) {
  return Astro.rewrite('/404');
}

// Both reads only need the URL param, so run them concurrently. The
// detached catch keeps an extensions-read failure from surfacing as an
// unhandled rejection when the developer read independently 404s the page.
// Accepted tradeoff: a request for a nonexistent developer id also starts
// the extensions read before the 404 rewrite. That wastes one upstream call
// on an invalid id, but keeps listExtensions off the critical path for every
// valid request — the far more common case — and repeat misses hit the
// per-colo data cache.
const extensionsPromise = listExtensions(env, { developer_id: id });
extensionsPromise.catch(() => {});

const developer = await getDeveloperById(env, id);

if (!developer) {
  return Astro.rewrite('/404');
}

const currentUser = await getSessionUser(Astro.cookies, env.sessionSecret);

let claimError: string | null = null;
let claimSubmitted = false;
let submittedNote = '';

if (Astro.request.method === 'POST' && developer.unclaimed) {
  const guard = await requireUser(Astro, env);
  if (guard instanceof Response) return guard;
  const user = guard;

  const form = await Astro.request.formData();
  submittedNote = formString(form, 'note');

  const api = createApiClient(env, user.sub);
  try {
    await api.claimDeveloper(developer.id, submittedNote || undefined);
    claimSubmitted = true;
  } catch (e) {
    claimError =
      e instanceof ApiRequestError
        ? getApiErrorMessage(e)
        : 'Unable to submit your claim. Please try again.';
  }
}

let extensionsPage: ExtensionListResponse | null = null;
let extensionsError: string | null = null;
try {
  extensionsPage = await extensionsPromise;
} catch (error) {
  extensionsError =
    error instanceof ApiRequestError
      ? error.message
      : 'Unable to load this developer’s extensions. Please try again.';
}

const extensions = extensionsPage?.result ?? [];
---

<Base
  title={`${developer.name} — FOSSBilling Extensions`}
  description={`Browse extensions and components for FOSSBilling by ${developer.name}.`}
>
  <div class="flex items-center gap-4 mb-8">
    <DeveloperAvatar
      avatarUrl={developer.avatar_url}
      type={developer.type}
      size="lg"
    />
    <div class="flex-1">
      <div class="flex items-center gap-2 flex-wrap">
        <h1 class="text-2xl font-semibold tracking-tight">{developer.name}</h1>
        <ProfileTrustBadge approved={developer.approved} publicView />
        {developer.unclaimed && (
          <span class="badge" data-variant="secondary">
            Unclaimed
          </span>
        )}
      </div>
      {developer.URL && isSafeHttpUrl(developer.URL) ? (
        <a
          href={developer.URL}
          target="_blank"
          rel="noopener noreferrer"
          class="btn mt-2"
          data-size="sm"
          data-variant="outline"
        >
          {developer.URL}
        </a>
      ) : (
        developer.URL && (
          <p class="text-sm text-muted-foreground mt-2">{developer.URL}</p>
        )
      )}
    </div>
  </div>

  {developer.unclaimed && (
    <div class="card mb-8">
      <header>
        <h2 class="font-semibold">
          This profile hasn't been linked to an account
        </h2>
      </header>
      <section class="space-y-3">
        {claimSubmitted ? (
          <p class="text-sm text-muted-foreground">
            Your claim has been submitted for moderator review. You can check
            its status on your{' '}
            <a href="/account/developer">developer profile page</a>.
          </p>
        ) : (
          <>
            <p class="text-sm text-muted-foreground">
              If this is you, you can request to claim it. A moderator reviews
              every claim before ownership changes.
            </p>
            {claimError && (
              <div class="alert" data-variant="destructive">
                <CircleAlert class="size-4" />
                <section>{claimError}</section>
              </div>
            )}
            {currentUser ? (
              <form method="POST" class="space-y-3">
                <div class="field">
                  <label for="note">
                    Note for the moderator reviewing this (optional)
                  </label>
                  <input
                    class="input"
                    type="text"
                    id="note"
                    name="note"
                    value={submittedNote}
                    maxlength="500"
                    placeholder="e.g. I'm the maintainer, see github.com/..."
                  />
                </div>
                <button type="submit" class="btn" data-size="sm">
                  Claim this profile
                </button>
              </form>
            ) : (
              <a
                href={`/auth/login?redirect=${encodeURIComponent(Astro.url.pathname)}`}
                data-astro-prefetch="false"
                class="btn"
                data-size="sm"
                data-variant="outline"
              >
                Sign In to Claim This Profile
              </a>
            )}
          </>
        )}
      </section>
    </div>
  )}

  <h2 class="font-semibold mb-4">Extensions by {developer.name}</h2>
  <div
    data-extension-catalogue
    data-api-url="/api/extensions"
    data-limit="50"
    data-developer-id={developer.id}
    data-has-more={
      extensionsPage ? hasNextPage(extensionsPage.pagination) : false
    }
  >
    {extensionsError ? (
      <div class="card" role="alert">
        <p class="text-muted-foreground">{extensionsError}</p>
      </div>
    ) : (
      <>
        <CatalogueSection
          extensions={extensions}
          pagination={extensionsPage?.pagination}
          emptyMessage="No published extensions yet."
        />
      </>
    )}
  </div>
</Base>

<script src="../../scripts/extension-catalogue.ts"></script>
