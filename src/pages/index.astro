---
import Base from '../layouts/Base.astro';
import CatalogueSection from '../components/CatalogueSection.astro';
import {
  clampApiPageLimit,
  ApiRequestError,
  listExtensions,
  type ExtensionListResponse,
} from '@/lib/api/client';
import { hasNextPage } from '@/lib/catalogue-pagination';
import { EXTENSION_TYPES, isExtensionType } from '@/types';

const env = Astro.locals.env;
const requestedType = Astro.url.searchParams.get('type');
const activeType = isExtensionType(requestedType) ? requestedType : undefined;
const requestedDeveloperId = Astro.url.searchParams.get('developer_id');
const activeDeveloperId = requestedDeveloperId || undefined;
const requestedLimit = Astro.url.searchParams.get('limit');
const activeLimit = clampApiPageLimit(
  requestedLimit === null ? undefined : Number(requestedLimit),
);

let cataloguePage: ExtensionListResponse | null = null;
let catalogueError: string | null = null;

try {
  cataloguePage = await listExtensions(env, {
    type: activeType,
    developer_id: activeDeveloperId,
    limit: activeLimit,
  });
} catch (error) {
  catalogueError =
    error instanceof ApiRequestError
      ? error.message
      : 'Unable to load the extension catalogue. Please try again.';
}

const extensions = cataloguePage?.result ?? [];
const activeFilterCount =
  Number(Boolean(activeType)) + Number(Boolean(activeDeveloperId));
---

<Base
  title="FOSSBilling Extensions"
  description="Browse, filter, and install community extensions for FOSSBilling — payment gateways, registrars, and more."
>
  <p class="text-muted-foreground mb-6">
    Welcome to the FOSSBilling Extension Directory.
  </p>
  <p class="text-muted-foreground mb-8">
    Please note that only extensions that can be auto-installed from within
    FOSSBilling are included in the directory at this time. For a list of other
    working extensions i.e., Registration modules please{' '}
    <a
      href="https://docs.fossbilling.org/extensions-and-development/extensions/"
      target="_blank"
      rel="noopener noreferrer"
      class="btn"
      data-size="sm"
      data-variant="ghost"
    >
      see here
    </a>{' '}
    .
  </p>

  <div
    data-extension-catalogue
    data-api-url="/api/extensions"
    data-limit={activeLimit}
    data-type={activeType}
    data-developer-id={activeDeveloperId}
    data-has-more={
      cataloguePage ? hasNextPage(cataloguePage.pagination) : false
    }
  >
    <details class="mb-8 w-full" open={activeFilterCount > 0}>
      <summary
        class="btn ml-auto flex w-fit"
        data-size="sm"
        data-variant="outline"
      >
        Filters
        {activeFilterCount > 0 ? (
          <span class="font-normal">({activeFilterCount} active)</span>
        ) : null}
      </summary>

      <form method="get" class="card mt-3 grid gap-4 px-6">
        <div class="grid gap-4 sm:grid-cols-2 sm:items-end">
          <label class="flex flex-col gap-2">
            <span class="font-medium text-sm">Extension Type</span>
            <select name="type" class="select w-full">
              <option value="">All Types</option>
              {EXTENSION_TYPES.map((type) => (
                <option value={type} selected={activeType === type}>
                  {type}
                </option>
              ))}
            </select>
          </label>
          <label class="flex flex-col gap-2">
            <span class="font-medium text-sm">Developer ID</span>
            <input
              type="text"
              name="developer_id"
              value={activeDeveloperId ?? ''}
              placeholder="Filter by Developer"
              class="input w-full"
            />
          </label>
        </div>
        <div class="flex items-center gap-3">
          <button type="submit" class="btn" data-variant="primary">
            Apply Filters
          </button>
          {activeType || activeDeveloperId ? (
            <a href="/" class="btn" data-variant="ghost">
              Clear Filters
            </a>
          ) : null}
        </div>
      </form>
    </details>

    {catalogueError ? (
      <div
        class="card flex min-h-32 flex-col items-center justify-center px-6 py-12 text-center"
        role="alert"
      >
        <h2 class="font-semibold">Unable to Load Extensions</h2>
        <p class="text-muted-foreground mt-2">{catalogueError}</p>
        <a href={Astro.url.pathname + Astro.url.search} class="btn mt-4">
          Try Again
        </a>
      </div>
    ) : (
      <>
        <CatalogueSection
          extensions={extensions}
          pagination={cataloguePage?.pagination}
          emptyMessage="No Extensions Match the Selected Filters"
          emptyAsCard
        />
      </>
    )}
  </div>
</Base>

<script src="../scripts/extension-catalogue.ts"></script>
