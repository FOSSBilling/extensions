---
import Base from '../layouts/Base.astro';

// Rewritten-to pages must carry a real 404 status for crawlers and cache
// semantics; direct visits to /404 get the same status.
Astro.response.status = 404;
---

<Base title="Page Not Found | FOSSBilling Extensions">
  <div class="text-center py-12">
    <h1 class="text-3xl font-bold tracking-tight mb-4">404 - Page Not Found</h1>
    <p class="text-muted-foreground mb-6">
      The page you're looking for doesn't exist.
    </p>
    <a href="/" class="btn">
      Back to Extensions
    </a>
  </div>
</Base>
