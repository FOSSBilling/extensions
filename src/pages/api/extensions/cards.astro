---
import ExtensionCard from '@/components/ExtensionCard.astro';
import {
  ApiRequestError,
  getApiErrorMessage,
  listExtensions,
  type ExtensionListResponse,
} from '@/lib/api/client';
import { parseCatalogueFilters } from '@/lib/catalogue-filters';

// Load-more fragment for the catalogue grids (see extension-catalogue.ts).
// Renders the same ExtensionCard component as the server-rendered first
// page, so card markup and server-signed icon URLs have exactly one source
// of truth. The pagination envelope rides on the wrapper's data attributes;
// the client parses cards out of the markup and dedupes by
// [data-extension-id].
const parsed = parseCatalogueFilters(Astro.url.searchParams);

let page: ExtensionListResponse | null = null;
let error: string | null = null;
if (parsed.error !== null) {
  error = parsed.error;
  Astro.response.status = 422;
} else {
  try {
    page = await listExtensions(Astro.locals.env, parsed.filters);
    // Matches /api/extensions: a short browser TTL so repeated load-more
    // and filter requests reuse the same cursor page; the edge cache for
    // the underlying read lives in the client-layer catalogue wrapper.
    Astro.response.headers.set('cache-control', 'public, max-age=30');
  } catch (e) {
    error =
      e instanceof ApiRequestError
        ? getApiErrorMessage(e)
        : 'Unable to load more extensions. Please try again.';
    Astro.response.status = 502;
  }
}
---

{error !== null ? (
  <div data-catalogue-error={error} />
) : page !== null ? (
  <div
    data-catalogue-page
    data-next-cursor={page.pagination.next_cursor ?? ''}
    data-has-more={page.pagination.has_more ? 'true' : 'false'}
  >
    {page.result.map((ext) => (
      <ExtensionCard ext={ext} />
    ))}
  </div>
) : null}
