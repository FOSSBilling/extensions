---
import Base from '../../../layouts/Base.astro';
import { env } from 'cloudflare:workers';
import { requireUser } from '@/lib/auth-guard';
import { createApiClient, ApiRequestError } from '@/lib/apiClient';
import { getAuthorByOwner } from '@/lib/database';
import { buildAuthorProfile } from '@/lib/author-form';
import { AUTHOR_TYPES } from '@/types';
import type { AuthorClaim, AuthorTransfer } from '@/types';

const guard = await requireUser(Astro, env);
if (guard instanceof Response) return guard;
const user = guard;

let author = await getAuthorByOwner(env.DB_EXTENSIONS, user.sub);
const isEdit = Boolean(author);

const api = createApiClient(env, user.sub);

let error: string | null = Astro.url.searchParams.get('error');
let transferResult: AuthorTransfer | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();

  // transfer-initiate can't redirect like every other action in this app
  // does — the token must never appear in a URL, so it's rendered inline
  // instead. transfer-revoke has no such constraint and lives in its own
  // route (transfer/revoke.ts), matching the rest of the app.
  if (form.get('intent') === 'transfer-initiate' && author) {
    try {
      transferResult = await api.initiateTransfer(author.id);
    } catch (e) {
      error =
        e instanceof ApiRequestError
          ? e.message
          : 'Unable to create a transfer link. Please try again.';
    }
  } else {
    const payload = buildAuthorProfile(form, author);
    try {
      author = await api.upsertAuthorProfile(payload);
      return Astro.redirect('/account?profile_saved=1');
    } catch (e) {
      error =
        e instanceof ApiRequestError
          ? e.message
          : 'Something went wrong saving your developer profile. Please try again.';
    }
  }
}

let myClaims: AuthorClaim[] = [];
if (!isEdit) {
  try {
    myClaims = await api.listMyClaims();
  } catch {
    // non-fatal — just don't show claim status
  }
}
---

<Base title="Developer profile — FOSSBilling Extensions">
  <div class="max-w-2xl mx-auto space-y-6">
    <h1 class="text-2xl font-semibold tracking-tight">Developer profile</h1>
    <p class="text-muted-foreground text-sm">
      This is the publisher identity shown on your extensions in the directory,
      and on your public developer page. Changes take effect immediately — you
      can submit extensions under this profile right away. A moderator will
      review it separately and mark it approved, shown as a badge below.
    </p>

    {
      !isEdit && myClaims.length > 0 && (
        <div class="card space-y-2">
          <h2 class="font-semibold">Your profile claims</h2>
          <ul class="space-y-2">
            {myClaims.map((c) => (
              <li class="text-sm flex items-center justify-between gap-3">
                <code>{c.author_id}</code>
                {c.status === 'pending' && (
                  <span class="badge-secondary">Pending review</span>
                )}
                {c.status === 'approved' && <span class="badge">Approved</span>}
                {c.status === 'rejected' && (
                  <span class="badge-secondary">
                    Rejected{c.review_note ? `: ${c.review_note}` : ''}
                  </span>
                )}
              </li>
            ))}
          </ul>
        </div>
      )
    }

    {
      isEdit && (
        <div class="card flex items-center gap-4">
          {author!.avatar_url && (
            <img
              src={author!.avatar_url}
              alt=""
              class="w-14 h-14 rounded-full object-cover"
            />
          )}
          <div class="flex-1">
            <p class="font-medium flex items-center gap-2">
              {author!.name}
              {author!.approved ? (
                <span class="badge">Approved</span>
              ) : (
                <span class="badge-secondary">Not yet reviewed</span>
              )}
            </p>
            {author!.bio && (
              <p class="text-sm text-muted-foreground mt-1">{author!.bio}</p>
            )}
          </div>
          <a
            href={`/developer/${author!.id}`}
            class="btn"
            data-size="sm"
            data-variant="outline"
          >
            View public profile
          </a>
        </div>
      )
    }

    {
      error && (
        <div class="rounded-md border border-destructive/50 bg-destructive/10 px-4 py-3 text-sm text-destructive">
          {error}
        </div>
      )
    }

    <form method="POST" class="space-y-8">
      <fieldset class="fieldset space-y-4">
        <legend class="font-semibold mb-2">Publisher identity</legend>
        <div class="field">
          <label for="id">Publisher ID</label>
          <input
            class="input"
            type="text"
            id="id"
            name="id"
            required
            pattern="[a-z0-9]+(-[a-z0-9]+)*"
            placeholder="my-org"
            value={author?.id}
            readonly={isEdit}
          />
          {
            isEdit && (
              <p class="text-sm text-muted-foreground">
                The ID can't be changed after it's created.
              </p>
            )
          }
        </div>
        <div class="field">
          <label for="name">Publisher name</label>
          <input
            class="input"
            type="text"
            id="name"
            name="name"
            required
            value={author?.name}
          />
        </div>
        <div class="field">
          <label for="type">Publisher type</label>
          <select class="select" id="type" name="type">
            {
              AUTHOR_TYPES.map((t) => (
                <option value={t} selected={author?.type === t}>
                  {t}
                </option>
              ))
            }
          </select>
        </div>
        <div class="field">
          <label for="url">Publisher URL (optional)</label>
          <input
            class="input"
            type="url"
            id="url"
            name="url"
            value={author?.URL}
          />
        </div>
      </fieldset>

      <fieldset class="fieldset space-y-4">
        <legend class="font-semibold mb-2">Public profile</legend>
        <p class="text-sm text-muted-foreground -mt-2">
          Shown on your public developer page at
          {author ? ` /developer/${author.id}` : ' /developer/<your-id>'}.
        </p>
        <div class="field">
          <label for="avatar_url">Avatar/logo URL (optional)</label>
          <input
            class="input"
            type="url"
            id="avatar_url"
            name="avatar_url"
            value={author?.avatar_url}
          />
        </div>
        <div class="field">
          <label for="bio">Bio (optional)</label>
          <textarea
            class="textarea"
            id="bio"
            name="bio"
            rows="4"
            maxlength="500"
            set:text={author?.bio ?? ''}
          />
          <p class="text-sm text-muted-foreground">Up to 500 characters.</p>
        </div>
      </fieldset>

      <fieldset class="fieldset space-y-4">
        <legend class="font-semibold mb-2">Private contact</legend>
        <div class="field">
          <label for="contact_email">Contact email (optional)</label>
          <input
            class="input"
            type="email"
            id="contact_email"
            name="contact_email"
            value={author?.contact_email}
          />
          <p class="text-sm text-muted-foreground">
            Never shown publicly — only visible to FOSSBilling moderators, in
            case they need to reach you about this profile or its extensions.
          </p>
        </div>
      </fieldset>

      <div class="flex justify-end gap-3">
        <a href="/account" class="btn" data-variant="ghost">Cancel</a>
        <button type="submit" class="btn">
          {isEdit ? 'Save changes' : 'Create developer profile'}
        </button>
      </div>
    </form>

    {
      isEdit && (
        <div class="card space-y-3">
          <h2 class="font-semibold">Transfer ownership</h2>
          <p class="text-sm text-muted-foreground">
            Generate a one-time link to hand this profile to a different
            account. It works once and expires after 24 hours — generating a new
            link invalidates any earlier one for this profile.
          </p>

          {Astro.url.searchParams.get('transfer_revoked') && (
            <p class="text-sm text-muted-foreground">
              Pending transfer link revoked.
            </p>
          )}
          {Astro.url.searchParams.get('transfer_accepted') && (
            <p class="text-sm text-muted-foreground">
              You've accepted a transfer — this profile is now yours.
            </p>
          )}

          {transferResult && (
            <div class="rounded-md border px-4 py-3 text-sm space-y-2">
              <p class="font-medium">
                Share this link with the new owner — it won't be shown again:
              </p>
              <code class="block break-all bg-muted p-2 rounded">
                {`${Astro.url.origin}/account/developer/transfer/${transferResult.token}`}
              </code>
              <p class="text-muted-foreground">
                Expires {new Date(transferResult.expires_at).toLocaleString()}.
              </p>
            </div>
          )}

          <div class="flex gap-3">
            <form method="POST">
              <input type="hidden" name="intent" value="transfer-initiate" />
              <button
                type="submit"
                class="btn"
                data-size="sm"
                data-variant="outline"
              >
                Generate transfer link
              </button>
            </form>
            <form method="POST" action="/account/developer/transfer/revoke">
              <button
                type="submit"
                class="btn"
                data-size="sm"
                data-variant="ghost"
              >
                Revoke pending link
              </button>
            </form>
          </div>
        </div>
      )
    }
  </div>
</Base>
