---
import Base from '../../../layouts/Base.astro';
import { requireUser } from '@/lib/auth-guard';
import {
  createApiClient,
  ApiRequestError,
  getApiErrorMessage,
} from '@/lib/api/client';
import {
  getDeveloperByOwner,
  getDeveloperById,
  getExtensionsByOwner,
} from '@/lib/extensions-data';
import {
  buildDeveloperProfile,
  DeveloperValidationError,
} from '@/lib/developer-form';
import { DEVELOPER_TYPES } from '@/types';
import { CircleAlert, CircleCheck, Copy } from '@lucide/astro';
import ConfirmDeleteDialog from '@/components/ConfirmDeleteDialog.astro';
import { setFlash } from '@/lib/flash';
import { formatDateTimeInZone } from '@/lib/format-date';
import { stripUrlScheme } from '@/lib/url-prefix';
import type { DeveloperClaim, DeveloperTransfer } from '@/lib/api/client';
import type { DeveloperProfileInput } from '@/lib/api/client';

const env = Astro.locals.env;
const guard = await requireUser(Astro, env);
if (guard instanceof Response) return guard;
const user = guard;

let developer = await getDeveloperByOwner(env, user.sub);
const isEdit = Boolean(developer);

// Gates both the delete-profile action below and full account deletion
// (/account/delete) — a developer profile with published extensions can't
// be removed without orphaning them first.
const extensions = isEdit ? await getExtensionsByOwner(env, user.sub) : [];

// Drives whether "Generate"/"Re-generate" wording and the "Revoke" button
// show — re-checked below after a successful transfer-initiate, since that
// action makes one pending without a redirect (see the comment on that
// branch) in between.
let pendingTransfer =
  isEdit && developer ? developer.has_pending_transfer === true : false;

const api = createApiClient(env, user.sub);

// The runtime adapter may provide an IANA name for the viewer's timezone.
// Falling back to UTC keeps this page portable to providers without request
// geolocation metadata.
const timeZone = Astro.locals.timeZone ?? 'UTC';

let myClaims: DeveloperClaim[] = [];
// Unlike the informational display on /account, a failure here must not
// fail open: this page's own gate below is the actual enforcement point for
// "only one profile per user", so an unknown claim state has to block
// creation the same as a known-pending one, not silently allow it.
let claimsLoadFailed = false;
if (!isEdit) {
  try {
    myClaims = await api.listMyClaims();
  } catch {
    claimsLoadFailed = true;
  }
}
// A user can only ever own one developer profile, so a pending claim (which
// may still be approved and transfer ownership at any time) blocks starting
// a separate one from scratch — same guard as the "Create" link on /account.
const pendingClaim = myClaims.find((c) => c.status === 'pending');

let error: string | null = null;
// Set only when creation failed because the id belongs to an existing,
// unowned profile (e.g. a legacy extension author) — points the user at
// the claim flow on that profile's public page instead of a dead end.
let idTaken = false;
let transferResult: DeveloperTransfer | null = null;
// Falls back to the just-submitted values on a failed save, so a rejected
// submission (e.g. duplicate id) doesn't blank the form and force retyping.
let submitted: DeveloperProfileInput | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();

  // transfer-initiate can't redirect like every other action in this app
  // does — the token must never appear in a URL, so it's rendered inline
  // instead. transfer-revoke has no such constraint and lives in its own
  // route (transfer/revoke.ts), matching the rest of the app.
  if (form.get('intent') === 'transfer-initiate' && developer) {
    try {
      transferResult = await api.initiateTransfer(developer.id);
      pendingTransfer = true;
    } catch (e) {
      error =
        e instanceof ApiRequestError
          ? e.message
          : 'Unable to create a transfer link. Please try again.';
    }
  } else if (form.get('intent') === 'delete' && developer) {
    // extensions.length > 0 falls through here as a no-op — the danger-zone
    // card below already explains why, so no separate error is needed.
    if (extensions.length === 0) {
      try {
        await api.deleteDeveloperProfile();
        setFlash(Astro.session, { title: 'Developer Profile Deleted.' });
        return Astro.redirect('/account');
      } catch (e) {
        error =
          e instanceof ApiRequestError
            ? e.message
            : 'Unable to delete your developer profile. Please try again.';
      }
    }
  } else if (!isEdit && claimsLoadFailed) {
    error = 'Unable to verify your claim status right now. Please try again.';
  } else if (!isEdit && pendingClaim) {
    error =
      'You have a pending claim on another profile — cancel it before creating a new one.';
  } else {
    try {
      const payload = buildDeveloperProfile(form, developer);
      submitted = payload;
      developer = await api.upsertDeveloperProfile(payload);
      setFlash(Astro.session, { title: 'Developer Profile Saved.' });
      return Astro.redirect('/account');
    } catch (e) {
      error =
        e instanceof ApiRequestError
          ? getApiErrorMessage(e)
          : e instanceof DeveloperValidationError
            ? e.message
            : 'Something went wrong saving your developer profile. Please try again.';
      // Matched on the api repo's dedicated DEVELOPER_ID_TAKEN code, not the
      // message text, so a reworded message can't silently break this. Only
      // points at the claim flow when the conflicting profile is actually
      // unclaimed — a profile someone else already owns has no claim option,
      // so showing this guidance there would be a dead end.
      if (
        !isEdit &&
        e instanceof ApiRequestError &&
        e.code === 'DEVELOPER_ID_TAKEN' &&
        submitted?.id
      ) {
        const conflicting = await getDeveloperById(env, submitted.id);
        idTaken = conflicting?.unclaimed === true;
      }
    }
  }
}

// Form field values only — isEdit/preview/transfer sections below still key
// off the real (saved) `developer`, not a failed, unsaved submission.
const fields = submitted ?? developer;
---

<Base title="Developer Profile — FOSSBilling Extensions">
  <div class="max-w-2xl mx-auto space-y-6">
    <h1 class="text-2xl font-semibold tracking-tight">Developer Profile</h1>
    <p class="text-muted-foreground text-sm">
      This is the publisher identity shown on your extensions in the directory,
      and on your public developer page. Changes take effect immediately — you
      can submit extensions under this profile right away. A moderator will
      review it separately and mark it approved, shown as a badge on your
      account page. Once your profile is GitHub verified, edits no longer need
      re-review.
    </p>

    {
      !isEdit && claimsLoadFailed && (
        <p class="text-sm text-destructive">
          Unable to load your profile claims right now.
        </p>
      )
    }

    {
      !isEdit && myClaims.length > 0 && (
        <div class="card">
          <header>
            <h2 class="font-semibold">Your Profile Claims</h2>
          </header>
          <section>
            <ul class="space-y-2">
              {myClaims.map((c) => (
                <li class="text-sm flex items-center justify-between gap-3">
                  <code>{c.developer_id}</code>
                  <div class="flex items-center gap-2">
                    {c.status === 'pending' && (
                      <span class="badge" data-variant="secondary">
                        Pending Review
                      </span>
                    )}
                    {c.status === 'approved' && (
                      <span class="badge">Approved</span>
                    )}
                    {c.status === 'rejected' && (
                      <span class="badge" data-variant="destructive">
                        Rejected{c.review_note ? `: ${c.review_note}` : ''}
                      </span>
                    )}
                    {c.status === 'pending' && (
                      <form
                        method="POST"
                        action={`/account/claims/${c.id}/cancel`}
                      >
                        <button
                          type="submit"
                          class="btn"
                          data-size="sm"
                          data-variant="ghost"
                        >
                          Cancel
                        </button>
                      </form>
                    )}
                  </div>
                </li>
              ))}
            </ul>
          </section>
        </div>
      )
    }

    {
      error && (
        <div class="alert" data-variant="destructive">
          <CircleAlert class="size-4" />
          <section>
            <p>{error}</p>
            {idTaken && submitted?.id && (
              <p>
                If this is your existing extension author profile, you can
                request to claim it instead of creating a new one — visit{' '}
                <a href={`/developer/${submitted.id}`} class="underline">
                  the public profile page for "{submitted.id}"
                </a>{' '}
                and use the "Claim this profile" option.
              </p>
            )}
          </section>
        </div>
      )
    }

    <div class="card">
      <section>
        {
          !isEdit && claimsLoadFailed ? (
            <p class="text-muted-foreground text-sm">
              Unable to verify your claim status right now, so profile creation
              is paused — please try again.
            </p>
          ) : !isEdit && pendingClaim ? (
            <p class="text-muted-foreground text-sm">
              You have a pending claim on{' '}
              <strong>{pendingClaim.developer_id}</strong>. Cancel it above
              before creating a separate profile — a claim can be approved at
              any time, and you can only ever own one.
            </p>
          ) : (
            <form method="POST" class="space-y-8">
              <div
                role="group"
                aria-label="Developer profile fields"
                class="fieldset"
              >
                <fieldset class="fieldset space-y-4">
                  <legend>Publisher Identity</legend>
                  <div class="field">
                    <label for="id">
                      Publisher ID <span class="text-destructive">*</span>
                    </label>
                    <input
                      class="input"
                      type="text"
                      id="id"
                      name="id"
                      required
                      pattern="[a-z0-9]+(-[a-z0-9]+)*"
                      placeholder="my-org"
                      value={fields?.id}
                      disabled={isEdit}
                    />
                    {isEdit ? (
                      <p>The ID can't be changed after it's created.</p>
                    ) : (
                      <p>
                        Typically your GitHub organization or username — this is
                        used to verify ownership if you (or someone else) later
                        try to claim this profile.
                      </p>
                    )}
                  </div>
                  <div class="field">
                    <label for="name">
                      Publisher Name <span class="text-destructive">*</span>
                    </label>
                    <input
                      class="input"
                      type="text"
                      id="name"
                      name="name"
                      required
                      value={fields?.name}
                    />
                  </div>
                  <fieldset class="fieldset">
                    <legend data-variant="label" class="mb-3">
                      Publisher Type
                    </legend>
                    <div role="radiogroup" aria-label="Publisher type">
                      <label for="type-user">
                        <div
                          role="group"
                          class="field"
                          data-orientation="horizontal"
                        >
                          <section>
                            <h3>User</h3>
                            <p>
                              Publisher ID must match your own GitHub username.
                            </p>
                          </section>
                          <input
                            class="input"
                            type="radio"
                            id="type-user"
                            name="type"
                            value="user"
                            checked={
                              (fields?.type ?? DEVELOPER_TYPES[0]) === 'user'
                            }
                          />
                        </div>
                      </label>
                      <label for="type-organization">
                        <div
                          role="group"
                          class="field"
                          data-orientation="horizontal"
                        >
                          <section>
                            <h3>Organization</h3>
                            <p>
                              Publisher ID must match a GitHub organization you
                              belong to.
                            </p>
                          </section>
                          <input
                            class="input"
                            type="radio"
                            id="type-organization"
                            name="type"
                            value="organization"
                            checked={fields?.type === 'organization'}
                          />
                        </div>
                      </label>
                    </div>
                  </fieldset>
                  <div class="field">
                    <label for="url" class="flex w-full items-center gap-1.5">
                      Publisher URL
                      {isEdit && developer!.github_url_verified && (
                        <CircleCheck
                          class="size-4 text-primary"
                          title="Matches your GitHub profile's website"
                        />
                      )}
                      <span class="badge ml-auto" data-variant="secondary">
                        Optional
                      </span>
                    </label>
                    <div class="input-group">
                      <span data-align="start" class="text-muted-foreground">
                        https://
                      </span>
                      <input
                        type="text"
                        id="url"
                        name="url"
                        value={stripUrlScheme(fields?.URL)}
                      />
                    </div>
                  </div>
                </fieldset>

                <div class="field-separator">
                  <hr role="separator" />
                </div>

                <fieldset class="fieldset space-y-4">
                  <legend>Public Profile</legend>
                  <p>
                    Shown on your public developer page at
                    {developer
                      ? ` /developer/${developer.id}`
                      : ' /developer/<your-id>'}
                    .
                  </p>
                  <div class="field">
                    <label
                      for="avatar_url"
                      class="flex w-full items-center gap-1.5"
                    >
                      Avatar/Logo URL
                      <span class="badge ml-auto" data-variant="secondary">
                        Optional
                      </span>
                    </label>
                    <div class="input-group">
                      <span data-align="start" class="text-muted-foreground">
                        https://
                      </span>
                      <input
                        type="text"
                        id="avatar_url"
                        name="avatar_url"
                        value={stripUrlScheme(
                          fields?.avatar_url ??
                            (!isEdit ? user.picture || undefined : undefined),
                        )}
                      />
                    </div>
                    {!isEdit && user.picture && (
                      <p>
                        Defaults to your GitHub avatar — change or clear it if
                        you'd rather use something else.
                      </p>
                    )}
                  </div>
                </fieldset>

                <div class="field-separator">
                  <hr role="separator" />
                </div>

                <fieldset class="fieldset space-y-4">
                  <legend>Private Contact</legend>
                  <div class="field">
                    <label
                      for="contact_email"
                      class="flex w-full items-center gap-1.5"
                    >
                      Contact Email
                      <span class="badge ml-auto" data-variant="secondary">
                        Optional
                      </span>
                    </label>
                    <input
                      class="input"
                      type="email"
                      id="contact_email"
                      name="contact_email"
                      value={
                        fields?.contact_email ??
                        (!isEdit ? user.email || undefined : undefined)
                      }
                    />
                    <p>
                      Never shown publicly — only visible to FOSSBilling
                      moderators, in case they need to reach you about this
                      profile or its extensions.
                      {!isEdit &&
                        user.email &&
                        " Defaults to your GitHub account email — change it if you'd rather use something else."}
                    </p>
                  </div>
                </fieldset>
              </div>

              <div class="flex gap-3">
                <button type="submit" class="btn">
                  {isEdit ? 'Save Changes' : 'Create Developer Profile'}
                </button>
                <a href="/account" class="btn" data-variant="ghost">
                  Cancel
                </a>
              </div>
            </form>
          )
        }
      </section>
    </div>

    {
      isEdit && (
        <div class="card" id="transfer-ownership">
          <header>
            <h2 class="font-semibold">Transfer Ownership</h2>
          </header>
          <section class="space-y-3">
            <p class="text-sm text-muted-foreground">
              Generate a one-time link to hand this profile to a different
              account. It works once and expires after 24 hours — generating a
              new link invalidates any earlier one for this profile.
            </p>

            {transferResult && (
              <div class="rounded-md border px-4 py-3 text-sm space-y-2">
                <p class="font-medium">
                  Share this link with the new owner — it won't be shown again:
                </p>
                <div class="input-group">
                  <input
                    type="text"
                    readonly
                    class="font-mono text-sm"
                    aria-label="Transfer link"
                    value={`${Astro.url.origin}/account/developer/transfer/${transferResult.token}`}
                  />
                  <button
                    type="button"
                    class="btn"
                    data-variant="ghost"
                    data-size="icon-xs"
                    data-align="end"
                    aria-label="Copy link"
                    title="Copy link"
                    onclick="navigator.clipboard.writeText(this.previousElementSibling.value).then(() => document.getElementById('toaster').toast({ category: 'success', title: 'Link copied to clipboard' })).catch(() => document.getElementById('toaster').toast({ category: 'error', title: 'Unable to copy link' }))"
                  >
                    <Copy class="size-4" />
                  </button>
                </div>
                <p class="text-muted-foreground">
                  Expires{' '}
                  {formatDateTimeInZone(transferResult.expires_at, timeZone)}.
                </p>
              </div>
            )}

            <div class="flex gap-3">
              <form method="POST">
                <input type="hidden" name="intent" value="transfer-initiate" />
                <button
                  type="submit"
                  class="btn"
                  data-size="sm"
                  data-variant="outline"
                >
                  {pendingTransfer
                    ? 'Re-generate Transfer Link'
                    : 'Generate Transfer Link'}
                </button>
              </form>
              {pendingTransfer && (
                <form method="POST" action="/account/developer/transfer/revoke">
                  <button
                    type="submit"
                    class="btn"
                    data-size="sm"
                    data-variant="ghost"
                  >
                    Revoke Pending Link
                  </button>
                </form>
              )}
            </div>
          </section>
        </div>
      )
    }

    {
      isEdit && (
        <div class="card">
          <header>
            <h2 class="font-semibold text-destructive">
              Delete Developer Profile
            </h2>
          </header>
          <section class="space-y-3">
            {extensions.length > 0 ? (
              <p class="text-sm text-muted-foreground">
                You have {extensions.length} published extension
                {extensions.length === 1 ? '' : 's'} under this profile.
                Transfer ownership or remove them before deleting it.
              </p>
            ) : (
              <>
                <p class="text-sm text-muted-foreground">
                  Permanently deletes your publisher identity (name, contact
                  info) and its public page. This can't be undone, and the ID
                  may be used by someone else afterward.
                </p>
                <button
                  type="button"
                  class="btn"
                  data-size="sm"
                  data-variant="outline"
                  onclick="document.getElementById('delete-developer-profile').showModal()"
                >
                  Delete Developer Profile
                </button>
                <ConfirmDeleteDialog
                  id="delete-developer-profile"
                  title="Delete developer profile"
                  description="Permanently deletes your publisher identity and its public page. This can't be undone, and the ID may be used by someone else afterward."
                  confirmText={developer!.id}
                  intentField={{ name: 'intent', value: 'delete' }}
                  submitLabel="Delete Developer Profile"
                />
              </>
            )}
          </section>
        </div>
      )
    }

    {
      /* transfer-initiate re-renders this page directly rather than
    redirecting (the token must never appear in a URL), so a #transfer-ownership
    URL fragment was the zero-JS way to scroll to the generated link — but
    that leaves the fragment sitting in the address bar afterward.
    scrollIntoView keeps the URL clean instead. */
    }
    <script is:inline define:vars={{ generated: Boolean(transferResult) }}>
      if (generated) {
        document.getElementById('transfer-ownership').scrollIntoView();
      }
    </script>
  </div>
</Base>
