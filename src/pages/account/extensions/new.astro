---
import Base from '../../../layouts/Base.astro';
import ExtensionForm from '@/components/ExtensionForm.astro';
import { requireUser } from '@/lib/auth-guard';
import {
  createApiClient,
  ApiRequestError,
  getApiErrorMessage,
} from '@/lib/api/client';
import { getDeveloperByOwner } from '@/lib/extensions-data';
import {
  buildExtensionCreatePayload,
  manifestFromCreateForm,
  echoNewExtensionFromForm,
  ExtensionValidationError,
} from '@/lib/extension-form';
import { packageFormData, sourceFile } from '@/lib/package-upload';
import { setFlash } from '@/lib/flash';

const env = Astro.locals.env;
const guard = await requireUser(Astro, env);
if (guard instanceof Response) return guard;
const user = guard;

const developer = await getDeveloperByOwner(env, user.sub);
if (!developer) {
  return Astro.redirect('/account/developer?required_for=extension');
}

let error: string | null = null;
// Falls back to the just-submitted values on a failed submission, so the
// form doesn't reset and discard the draft (same echo as the edit page).
let submitted: ReturnType<typeof echoNewExtensionFromForm> | null = null;

if (Astro.request.method === 'POST') {
  const api = createApiClient(env, user.sub);
  try {
    const form = await packageFormData(Astro.request);
    submitted = echoNewExtensionFromForm(form, developer);
    const file = sourceFile(form, true)!;
    const artifact = await api.buildPackage(manifestFromCreateForm(form), file);
    const payload = buildExtensionCreatePayload(form, artifact);
    await api.createExtension(payload);
    await setFlash(Astro, Astro.locals.env.sessionSecret, {
      title: 'Submitted for Review.',
    });
    return Astro.redirect(`/extension/${payload.id}`);
  } catch (e) {
    error =
      e instanceof ApiRequestError
        ? getApiErrorMessage(e)
        : e instanceof ExtensionValidationError
          ? e.message
          : 'Something went wrong submitting your extension. Please try again.';
  }
}
---

<Base title="Submit an Extension — FOSSBilling Extensions">
  <div class="max-w-2xl mx-auto space-y-6">
    <h1 class="text-2xl font-semibold tracking-tight">Submit an Extension</h1>
    <p class="text-muted-foreground text-sm">
      Submissions are reviewed by a moderator before appearing in the public
      directory.
    </p>
    <ExtensionForm
      developer={developer}
      echo={submitted?.extension}
      releaseDraft={submitted?.releaseDraft}
      error={error}
    />
  </div>
</Base>
