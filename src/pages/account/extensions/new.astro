---
import Base from '../../../layouts/Base.astro';
import DirectoryListingFields from '@/components/DirectoryListingFields.astro';
import { requireUser } from '@/lib/auth-guard';
import { getSessionUser } from '@/lib/session';
import {
  createApiClient,
  ApiRequestError,
  getApiErrorMessage,
} from '@/lib/api/client';
import { getDeveloperByOwner } from '@/lib/extensions-data';
import {
  buildExtensionCreatePayload,
  ExtensionValidationError,
} from '@/lib/extension-form';
import { packageFormData } from '@/lib/package-upload';
import { formString } from '@/lib/form';
import { setFlash } from '@/lib/flash';

const env = Astro.locals.env;
if (Astro.request.method === 'POST') {
  const user = await getSessionUser(Astro.cookies, env.sessionSecret);
  if (!user)
    return Response.json(
      {
        error:
          'Your session has expired. Sign in again to submit the extension.',
      },
      { status: 401 },
    );
  const api = createApiClient(env, user.sub);
  try {
    const form = await packageFormData(Astro.request);
    const job = await api.getPackageJob(formString(form, 'job_id'));
    if (job.status !== 'ready' || !job.artifact)
      throw new ExtensionValidationError(
        'The package is not ready. Wait for processing and try again.',
        409,
      );
    const artifact = job.artifact;
    const payload = buildExtensionCreatePayload(form, artifact);
    await api.createExtension(payload);
    await setFlash(Astro, Astro.locals.env.sessionSecret, {
      title: 'Submitted for Review.',
    });
    return Response.json({ url: `/extension/${payload.identifier}` });
  } catch (error) {
    const message =
      error instanceof ApiRequestError
        ? getApiErrorMessage(error)
        : error instanceof ExtensionValidationError
          ? error.message
          : 'Something went wrong submitting your extension. Please try again.';
    const status =
      error instanceof ApiRequestError ||
      error instanceof ExtensionValidationError
        ? error.status
        : 503;
    return Response.json({ error: message }, { status });
  }
}

const guard = await requireUser(Astro, env);
if (guard instanceof Response) return guard;
const user = guard;

const developer = await getDeveloperByOwner(env, user.sub);
if (!developer) {
  return Astro.redirect('/account/developer?required_for=extension');
}
---

<Base title="Submit an Extension — FOSSBilling Extensions">
  <div class="max-w-2xl mx-auto space-y-6">
    <h1 class="text-2xl font-semibold tracking-tight">Submit an Extension</h1>
    <p class="text-muted-foreground text-sm">
      Submissions are reviewed by a moderator before appearing in the public
      directory.
    </p>
    <div id="new-extension">
      <noscript>
        <p>JavaScript is required to prepare an extension package.</p>
      </noscript>
      <p
        class="alert"
        data-variant="destructive"
        role="alert"
        data-upload-error
        hidden
      ></p>
      <form method="POST" class="space-y-5">
        <label class="grid gap-2 text-sm font-medium">
          Extension ZIP
          <input
            id="source"
            type="file"
            class="input w-full"
            accept=".zip,application/zip"
          />
        </label>
        <label class="grid gap-2 text-sm font-medium">
          GitHub Release ZIP URL
          <input
            class="input w-full"
            name="github_url"
            type="url"
            maxlength="2048"
          />
        </label>
        <p class="text-xs text-muted-foreground">
          Upload a ZIP or link to a public GitHub release asset. The ZIP can be
          up to 5 MiB and must contain manifest.json at its root.
        </p>
        <DirectoryListingFields />
        <label class="grid gap-2 text-sm font-medium">
          Release Date
          <input
            class="input w-full"
            name="release_date"
            type="date"
            required
          />
        </label>
        <label class="grid gap-2 text-sm font-medium">
          Changelog URL
          <input class="input w-full" name="changelog_url" type="url" />
        </label>
        <button type="submit" class="btn">
          Submit for Review
        </button>
      </form>
    </div>
  </div>
</Base>

<script>
  import {
    reservePackageUpload,
    completePackageUpload,
    importGitHubPackage,
    readPackageJob,
  } from '@/lib/package-upload';

  import { formString } from '@/lib/form';
  import { waitForPackageJob } from '@/lib/package-job';

  const root = document.querySelector('#new-extension');
  const form = root?.querySelector('form');
  const input = root?.querySelector<HTMLInputElement>('#source');
  const error = root?.querySelector<HTMLElement>('[data-upload-error]');
  const submit = form?.querySelector<HTMLButtonElement>(
    'button[type="submit"]',
  );
  if (form && submit && error) {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (submit.disabled) return;
      const label = submit.textContent;
      submit.disabled = true;
      error.hidden = true;
      try {
        const file = input?.files?.[0];
        const body = new FormData(form);
        const githubUrl = formString(body, 'github_url');
        body.delete('github_url');
        if (Boolean(file) === Boolean(githubUrl))
          throw new Error(
            'Choose a ZIP file or enter a GitHub Release ZIP URL.',
          );
        submit.textContent = file
          ? 'Uploading Source ZIP…'
          : 'Importing Package…';
        const job = file
          ? await completePackageUpload(await reservePackageUpload(file), file)
          : await importGitHubPackage(githubUrl);
        submit.textContent = 'Processing Package…';
        await waitForPackageJob(job, readPackageJob);
        body.set('job_id', job.id);
        submit.textContent = 'Submitting for Review…';
        const response = await fetch(location.pathname, {
          method: 'POST',
          body,
          redirect: 'manual',
        });
        if (response.status === 0 || response.status === 302)
          throw new Error(
            'Your session has expired. Sign in again to submit the extension.',
          );
        const result = (await response.json()) as {
          url?: string;
          error?: string;
        };
        if (!response.ok || !result.url)
          throw new Error(
            result.error || 'Unable to submit the extension. Please try again.',
          );
        location.assign(result.url);
      } catch (cause) {
        error.textContent =
          cause instanceof Error
            ? cause.message
            : 'Unable to submit the extension.';
        error.hidden = false;
      } finally {
        submit.disabled = false;
        submit.textContent = label;
      }
    });
  }
</script>
