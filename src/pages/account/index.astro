---
import Base from '../../layouts/Base.astro';
import { requireUser } from '@/lib/auth-guard';
import {
  ApiRequestError,
  createApiClient,
  listMyClaimsSafely,
} from '@/lib/api/client';
import { getDeveloperByOwner, getExtensionsByOwner } from '@/lib/database';
import { isModerator, hasLinkedGithub } from '@/lib/users';
import { ISSUER } from '@/lib/oauth';
import { getLatestRelease } from '@/types';
import type { DeveloperClaim, Submission } from '@/lib/api/client';
import { CircleAlert } from '@lucide/astro';
import ProfileTrustBadge from '@/components/ProfileTrustBadge.astro';
import DeveloperAvatar from '@/components/DeveloperAvatar.astro';
import { formatDate } from '@/lib/format-date';
import { cursorPageUrl } from '@/lib/pagination';
import { getOptimizedImageUrl } from '@/lib/image-url';

const env = Astro.locals.env;
const guard = await requireUser(Astro, env);
if (guard instanceof Response) return guard;
const user = guard;
const userPictureUrl = getOptimizedImageUrl(user.picture, 'avatar');

const [ownedExtensions, moderator, developer, githubLinked] = await Promise.all(
  [
    getExtensionsByOwner(env.db, user.sub),
    isModerator(env.db, user.sub),
    getDeveloperByOwner(env.db, user.sub),
    hasLinkedGithub(env.db, user.sub),
  ],
);

const api = createApiClient(env, user.sub);
let submissions: Submission[] = [];
let submissionsNextCursor: string | null = null;
let submissionsHasMore = false;
let submissionsError: string | null = null;
try {
  const submissionsPage = await api.listMySubmissions({
    cursor: Astro.url.searchParams.get('submissions_cursor') ?? undefined,
  });
  submissions = submissionsPage.result;
  submissionsNextCursor = submissionsPage.pagination.next_cursor;
  submissionsHasMore = submissionsPage.pagination.has_more;
} catch (error) {
  submissionsError =
    error instanceof ApiRequestError
      ? error.message
      : 'Unable to load your submissions right now.';
}

const nextSubmissionsUrl =
  submissionsHasMore &&
  submissionsNextCursor !== null &&
  submissionsNextCursor.length > 0
    ? cursorPageUrl(Astro.url, 'submissions_cursor', submissionsNextCursor)
    : null;

const myClaims: DeveloperClaim[] = developer
  ? []
  : await listMyClaimsSafely(api);
// listMyClaims returns newest first; approved claims transfer ownership
// immediately (developer becomes truthy), so only pending/rejected ever
// surface here.
const latestClaim = myClaims[0];
// A user can only ever own one developer profile, so a pending claim (which
// may still be approved and transfer ownership at any time) blocks starting
// a separate one from scratch — checked across all claims, not just
// latestClaim, since claim() doesn't prevent pending claims on multiple ids.
const pendingClaim = myClaims.find((c) => c.status === 'pending');
// Prefer showing the pending claim over a newer non-pending one — otherwise
// an older pending claim (Create hidden because of it) could have no
// visible cancel action if a newer claim on a different id was rejected
// since, leaving the page with no way to proceed.
const displayClaim = pendingClaim ?? latestClaim;

let reverifyCooldownUntil =
  (await Astro.session?.get('reverifyCooldownUntil')) ?? 0;
if (reverifyCooldownUntil <= Date.now()) {
  Astro.session?.delete('reverifyCooldownUntil');
  reverifyCooldownUntil = 0;
}

const statusBadgeVariant: Record<Submission['status'], string | undefined> = {
  pending: 'secondary',
  approved: undefined,
  rejected: 'destructive',
};

// After linking GitHub, send the user back through our own OIDC login
// (rather than stranding them on auth's own /account page) so the ID token
// is re-issued with the freshly linked github_login/github_orgs claims and
// upsertUser refreshes our local copy — otherwise the reconnect banner keeps
// showing until the next unrelated login.
const reconnectUrl = `${ISSUER}/account?callbackURL=${encodeURIComponent(
  `${Astro.url.origin}/auth/login?redirect=${encodeURIComponent('/account')}`,
)}`;
---

<Base title="Your Account — FOSSBilling Extensions">
  <div class="max-w-3xl mx-auto space-y-8">
    <header class="flex items-center justify-between gap-4">
      <div class="flex items-center gap-4">
        {
          userPictureUrl && (
            <span class="avatar w-12 h-12">
              <img
                src={userPictureUrl}
                width="48"
                height="48"
                class="object-contain"
                alt=""
                decoding="async"
              />
            </span>
          )
        }
        <div>
          <h1 class="text-2xl font-semibold tracking-tight">{user.name}</h1>
          <p class="text-muted-foreground text-sm">{user.email}</p>
        </div>
      </div>
      <div class="flex items-center gap-2">
        <a href="/account/profile" class="btn" data-variant="outline">
          Your Profile
        </a>
        {
          moderator && (
            <a href="/account/moderate" class="btn" data-variant="outline">
              Moderation Queue
            </a>
          )
        }
      </div>
    </header>

    {
      !githubLinked && (
        <div class="alert">
          <h2>Reconnect GitHub</h2>
          <section>
            Grant GitHub organization access so profile claims can be verified
            automatically.
          </section>
          <footer>
            <a
              href={reconnectUrl}
              class="btn"
              data-size="sm"
              data-variant="outline"
            >
              Reconnect GitHub
            </a>
          </footer>
        </div>
      )
    }

    <!-- overflow-visible: basecoat's .card sets overflow-hidden (to clip a
         first/last-child image to its rounded corners, not relevant here)
         which otherwise clips ProfileTrustBadge's/Re-verify's tooltips. -->
    <section class="card overflow-visible">
      <header class="flex items-center justify-between">
        <h2 class="font-semibold">Developer Profile</h2>
        {
          developer ? (
            <a
              href="/account/developer"
              class="btn"
              data-size="sm"
              data-variant="outline"
            >
              Edit
            </a>
          ) : (
            !pendingClaim && (
              <a
                href="/account/developer"
                class="btn"
                data-size="sm"
                data-variant="outline"
              >
                Create
              </a>
            )
          )
        }
      </header>
      <section>
        {
          developer ? (
            <div class="space-y-3">
              <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
                <div class="flex items-center gap-4">
                  <DeveloperAvatar
                    avatarUrl={developer.avatar_url}
                    type={developer.type}
                  />
                  <div class="flex-1">
                    <p class="font-medium flex items-center gap-2">
                      {developer.name}
                      <ProfileTrustBadge
                        approved={developer.approved}
                        githubOrgVerified={developer.github_org_verified}
                        githubVerifiedAt={developer.github_verified_at}
                      />
                    </p>
                    <p class="text-sm text-muted-foreground">{developer.id}</p>
                  </div>
                </div>
                <div class="flex items-center gap-2">
                  <a
                    href={`/developer/${developer.id}`}
                    class="btn"
                    data-size="sm"
                    data-variant="outline"
                  >
                    View Public Profile
                  </a>
                  <form
                    method="POST"
                    action="/account/developer/reverify"
                    data-reverify-form
                    data-cooldown-until={reverifyCooldownUntil || undefined}
                  >
                    <button
                      type="submit"
                      class="btn"
                      disabled={reverifyCooldownUntil > 0}
                      aria-label={
                        reverifyCooldownUntil > 0
                          ? 'Re-verify unavailable temporarily'
                          : 'Re-verify'
                      }
                      data-size="sm"
                      data-variant={
                        developer.github_org_verified === false
                          ? 'primary'
                          : 'ghost'
                      }
                      data-tooltip="Check GitHub verification now"
                      data-side="bottom"
                    >
                      {reverifyCooldownUntil > 0
                        ? 'Try again shortly'
                        : 'Re-verify'}
                    </button>
                  </form>
                </div>
              </div>
              {developer.github_org_verified === false && (
                <div class="alert" data-variant="destructive">
                  <CircleAlert class="size-4" />
                  <section>
                    Your linked GitHub identity no longer matches this profile.
                    This doesn't affect your submissions or ownership — it's
                    only shown to moderators as a trust signal. Re-verify if
                    this should still match (e.g. you rejoined the
                    organization).
                  </section>
                </div>
              )}
            </div>
          ) : displayClaim ? (
            <div class="space-y-2">
              <p class="text-sm flex items-center gap-2">
                Claim on <strong>{displayClaim.developer_id}</strong>
                {displayClaim.status === 'pending' && (
                  <span class="badge" data-variant="secondary">
                    Pending Review
                  </span>
                )}
                {displayClaim.status === 'rejected' && (
                  <span class="badge" data-variant="destructive">
                    Rejected
                    {displayClaim.review_note
                      ? `: ${displayClaim.review_note}`
                      : ''}
                  </span>
                )}
              </p>
              {displayClaim.status === 'pending' && (
                <div class="flex items-center gap-2">
                  <p class="text-muted-foreground text-sm">
                    You can't create a separate profile while this claim is
                    pending.
                  </p>
                  <form
                    method="POST"
                    action={`/account/claims/${displayClaim.id}/cancel`}
                  >
                    <button
                      type="submit"
                      class="btn"
                      data-size="sm"
                      data-variant="ghost"
                    >
                      Cancel Claim
                    </button>
                  </form>
                </div>
              )}
            </div>
          ) : (
            <p class="text-muted-foreground text-sm">
              You don't have a developer profile yet — create one before
              submitting an extension.
            </p>
          )
        }
      </section>
    </section>

    <section class="card">
      <header class="flex items-center justify-between">
        <h2 class="font-semibold">Your Extensions</h2>
        <a href="/account/extensions/new" class="btn" data-size="sm">
          Submit New Extension
        </a>
      </header>
      <section>
        {
          ownedExtensions.length === 0 ? (
            <p class="text-muted-foreground text-sm">
              You don't have any published extensions yet.
            </p>
          ) : (
            <ul class="divide-y divide-border">
              {ownedExtensions.map((ext) => {
                const latest = getLatestRelease(ext);
                return (
                  <li class="py-3 flex items-center justify-between gap-3">
                    <div>
                      <p class="font-medium">{ext.name}</p>
                      <p class="text-sm text-muted-foreground">
                        v{latest?.tag ?? 'unknown'}
                      </p>
                    </div>
                    <div class="flex gap-2">
                      <a
                        href={`/extension/${ext.id}`}
                        class="btn"
                        data-size="sm"
                        data-variant="ghost"
                      >
                        View
                      </a>
                      <a
                        href={`/account/extensions/${ext.id}/edit`}
                        class="btn"
                        data-size="sm"
                        data-variant="outline"
                      >
                        Edit
                      </a>
                    </div>
                  </li>
                );
              })}
            </ul>
          )
        }
      </section>
    </section>

    <section class="card">
      <header>
        <h2 class="font-semibold">Your Submissions</h2>
      </header>
      <section>
        {
          submissionsError ? (
            <p class="text-sm text-destructive">{submissionsError}</p>
          ) : submissions.length === 0 ? (
            <p class="text-muted-foreground text-sm">No submissions yet.</p>
          ) : (
            <>
              <ul class="divide-y divide-border">
                {submissions.map((s) => (
                  <li class="py-3 flex items-center justify-between gap-3">
                    <div>
                      <p class="font-medium">{s.payload.extension.name}</p>
                      <p class="text-sm text-muted-foreground">
                        {s.extension_id ? 'Edit' : 'New extension'} &middot;
                        submitted {formatDate(s.created_at)}
                      </p>
                      {s.status === 'rejected' && s.review_note && (
                        <p class="text-sm text-destructive mt-1">
                          {s.review_note}
                        </p>
                      )}
                    </div>
                    <span
                      class="badge"
                      data-variant={statusBadgeVariant[s.status]}
                    >
                      {s.status}
                    </span>
                  </li>
                ))}
              </ul>
              {nextSubmissionsUrl && (
                <a href={nextSubmissionsUrl} class="btn mt-4">
                  Next submissions page
                </a>
              )}
            </>
          )
        }
      </section>
    </section>

    <div class="text-center">
      <a href="/account/delete" class="text-sm text-destructive">
        Delete Account
      </a>
    </div>
  </div>
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-reverify-form]');
  const button = form?.querySelector<HTMLButtonElement>(
    'button[type="submit"]',
  );

  if (form && button) {
    const cooldownUntil = Number(form.dataset.cooldownUntil ?? 0);
    if (cooldownUntil > Date.now()) {
      button.disabled = true;
      window.setTimeout(() => {
        button.disabled = false;
        button.textContent = 'Re-verify';
        button.setAttribute('aria-label', 'Re-verify');
      }, cooldownUntil - Date.now());
    }

    let submitting = false;
    form.addEventListener('submit', (event) => {
      if (submitting || cooldownUntil > Date.now()) {
        event.preventDefault();
        return;
      }

      submitting = true;
      button.disabled = true;
      button.textContent = 'Re-verifying…';
      button.setAttribute('aria-label', 'Re-verifying GitHub account');
      button.setAttribute('aria-busy', 'true');
    });
  }
</script>
