---
import Admin from '../../../layouts/Admin.astro';
import { requireModerator } from '@/lib/auth-guard';
import { createApiClient } from '@/lib/api/client';
import ApproveDialog from '@/components/ApproveDialog.astro';
import RejectDialog from '@/components/RejectDialog.astro';
import EmptyState from '@/components/admin/EmptyState.astro';
import DeveloperProfilesTable from '@/components/admin/DeveloperProfilesTable.astro';
import PendingRevisionsTable from '@/components/admin/PendingRevisionsTable.astro';

const env = Astro.locals.env;
const guard = await requireModerator(Astro, env);
if (guard instanceof Response) return guard;
const user = guard;

const api = createApiClient(env, user.sub);

// Overview stays cheap: small pages per queue, no detail fan-out. Cards
// link into the filtered tab where the full paginated list lives.
const [revisionsResult, developersResult, claimsResult] =
  await Promise.allSettled([
    api.listModerationQueue('pending', { limit: 5 }),
    api.listUnapprovedDevelopers(),
    api.listPendingClaims(),
  ]);

const pendingRevisions =
  revisionsResult.status === 'fulfilled' ? revisionsResult.value.result : [];
const revisionsError =
  revisionsResult.status === 'rejected'
    ? 'Unable to load revision queue.'
    : null;
const revisionsHasMore =
  revisionsResult.status === 'fulfilled' &&
  revisionsResult.value.pagination.has_more;

const unapprovedDevelopers =
  developersResult.status === 'fulfilled' ? developersResult.value : [];
const developersError =
  developersResult.status === 'rejected' ? 'Unable to load developers.' : null;

const pendingClaims =
  claimsResult.status === 'fulfilled' ? claimsResult.value : [];
const claimsError =
  claimsResult.status === 'rejected' ? 'Unable to load claims.' : null;

const stats = [
  {
    label: 'Pending Revisions',
    value: revisionsError
      ? '!'
      : `${pendingRevisions.length}${revisionsHasMore ? '+' : ''}`,
    href: '/account/admin/revisions',
    hint: 'Extension Edits Awaiting Review',
  },
  {
    label: 'Developers Awaiting Review',
    value: developersError ? '!' : `${unapprovedDevelopers.length}`,
    href: '/account/admin/developers',
    hint: 'Trust-Badge Approvals',
  },
  {
    label: 'Profile Claims',
    value: claimsError ? '!' : `${pendingClaims.length}`,
    href: '/account/admin/developers?view=claims',
    hint: 'Ownership Transfers to Judge',
  },
];
---

<Admin
  title="Overview — FOSSBilling Extensions"
  active="overview"
  description="Pending work across revisions, developers and claims. Open a section to review."
>
  <div class="grid gap-4 sm:grid-cols-3">
    {stats.map((s) => (
      <a
        href={s.href}
        class="card p-3 flex flex-row items-center gap-3 hover:border-primary transition-colors"
      >
        <p class="text-2xl font-semibold tracking-tight">{s.value}</p>
        <div class="min-w-0">
          <p class="text-sm font-medium leading-tight">{s.label}</p>
          <p class="text-xs text-muted-foreground leading-tight">{s.hint}</p>
        </div>
      </a>
    ))}
  </div>

  {(revisionsError ?? developersError ?? claimsError) && (
    <p class="text-sm text-destructive">
      {[revisionsError, developersError, claimsError]
        .filter(Boolean)
        .join(' ')}
    </p>
  )}

  <section class="space-y-3">
    <div class="flex items-center justify-between gap-3">
      <h2 class="font-semibold">Pending Revisions</h2>
      <a
        href="/account/admin/revisions"
        class="btn"
        data-size="sm"
        data-variant="outline"
      >
        View All
      </a>
    </div>
    {pendingRevisions.length === 0 ? (
      <EmptyState
        title="Revision Queue Is Clear"
        description="New extension submissions and edits will appear here."
      />
    ) : (
      <PendingRevisionsTable revisions={pendingRevisions} />
    )}
  </section>

  <section class="space-y-3">
    <div class="flex items-center justify-between gap-3">
      <h2 class="font-semibold">Pending Developers</h2>
        <a
          href="/account/admin/developers"
          class="btn"
          data-size="sm"
          data-variant="outline"
        >
          View All
        </a>
      </div>
      {unapprovedDevelopers.length === 0 ? (
        <p class="text-sm text-muted-foreground">No Pending Profiles</p>
      ) : (
        <DeveloperProfilesTable
          developers={unapprovedDevelopers.slice(0, 5)}
        />
      )}
    </section>
    <section class="space-y-3">
      <div class="flex items-center justify-between gap-3">
        <h2 class="font-semibold">Pending Claims</h2>
        <a
          href="/account/admin/developers?view=claims"
          class="btn"
          data-size="sm"
          data-variant="outline"
        >
          View All
        </a>
      </div>
      {pendingClaims.length === 0 ? (
        <p class="text-sm text-muted-foreground">No Claims Awaiting Review</p>
      ) : (
        <ul class="space-y-4">
          {pendingClaims.slice(0, 5).map((c) => (
            <li class="card gap-4 p-5 scroll-mt-24" id={`claim-${c.id}`}>
              <header class="px-0">
                <h3 class="font-semibold flex flex-wrap items-center gap-2">
                  {c.developer_name} ({c.developer_id})
                  {c.github_org_verified && (
                    <span class="badge">GitHub Verified</span>
                  )}
                </h3>
                <p class="text-sm text-muted-foreground">
                  {c.developer_type} · claimed by{' '}
                  <strong>{c.claimant_name ?? c.claimant_id}</strong>
                  {c.claimant_github_login && (
                    <>
                      {' '}
                      <a href={`https://github.com/${c.claimant_github_login}`}>
                        @{c.claimant_github_login}
                      </a>
                    </>
                  )}
                </p>
                {c.note && <p class="text-sm mt-1">&ldquo;{c.note}&rdquo;</p>}
              </header>
              <footer class="flex items-center gap-2 flex-wrap">
                <button
                  type="button"
                  class="btn"
                  data-size="sm"
                  onclick={`document.getElementById('approve-claim-${c.id}').showModal()`}
                >
                  Approve
                </button>
                <button
                  type="button"
                  class="btn"
                  data-size="sm"
                  data-variant="destructive"
                  onclick={`document.getElementById('reject-claim-${c.id}').showModal()`}
                >
                  Reject
                </button>
              </footer>

              <ApproveDialog
                id={`approve-claim-${c.id}`}
                title={`Approve claim on "${c.developer_id}"?`}
                description="The claimant will gain ownership of this profile immediately."
                formAction={`/account/admin/developers/claims/${c.id}/approve`}
                notifyRecipient="claimant"
                hiddenFields={[{ name: 'intent', value: 'approve' }]}
              />
              <RejectDialog
                id={`reject-claim-${c.id}`}
                title={`Reject claim on "${c.developer_id}"?`}
                description="The claimant will see this reason."
                formAction={`/account/admin/developers/claims/${c.id}/reject`}
                notifyRecipient="claimant"
              />
            </li>
          ))}
        </ul>
      )}
    </section>
</Admin>

<script>
  import { initRevisionQueue } from '@/lib/admin-revisions-client';
  initRevisionQueue();

  // Single shared approve dialog for the developers table above: each row
  // button carries its developer on data attributes (same as
  // /account/admin/developers).
  const developerDialog = document.querySelector<HTMLDialogElement>(
    '#admin-approve-developer',
  );

  document.addEventListener('click', (event) => {
    const button = (
      event.target as HTMLElement | null
    )?.closest<HTMLButtonElement>('button[data-approve-developer]');
    if (!button || !developerDialog) return;

    const id = button.dataset.developerId ?? '';
    const form = developerDialog.querySelector('form');
    const titleEl = developerDialog.querySelector('h2');
    const revisionInput = developerDialog.querySelector<HTMLInputElement>(
      'input[name="expected_revision"]',
    );
    if (form) form.action = `/account/admin/developers/${id}/approve`;
    if (titleEl) {
      titleEl.textContent = `Approve "${button.dataset.developerName ?? id}"?`;
    }
    if (revisionInput) {
      revisionInput.value = button.dataset.expectedRevision ?? '';
    }
    developerDialog.showModal();
  });
</script>
