---
import Base from '../../../layouts/Base.astro';
import { requireUser } from '@/lib/auth-guard';
import { getUserProfile, updateUserProfile } from '@/lib/users';
import { formString } from '@/lib/form';
import { setFlash } from '@/lib/flash';

const env = Astro.locals.env;
const guard = await requireUser(Astro, env);
if (guard instanceof Response) return guard;
const user = guard;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const displayName = formString(form, 'display_name');

  await updateUserProfile(env.db, user.sub, {
    display_name: displayName || null,
  });
  setFlash(Astro.session, { title: 'Profile Updated.' });
  return Astro.redirect('/account');
}

const profile = await getUserProfile(env.db, user.sub);
---

<Base title="Your Profile — FOSSBilling Extensions">
  <div class="max-w-2xl mx-auto space-y-6">
    <h1 class="text-2xl font-semibold tracking-tight">Your Profile</h1>
    <p class="text-muted-foreground text-sm">
      Your personal profile, separate from any developer/publisher identity.
    </p>

    <div class="card">
      <section>
        <form method="POST" class="space-y-6">
          <div class="field">
            <label for="display_name">Display Name</label>
            <input
              class="input"
              type="text"
              id="display_name"
              name="display_name"
              placeholder={user.name}
              value={profile.display_name ?? ''}
            />
            <p class="text-sm text-muted-foreground">
              Defaults to "{user.name}" from your sign-in provider if left
              blank.
            </p>
          </div>

          <div class="flex gap-3">
            <button type="submit" class="btn">Save</button>
            <a href="/account" class="btn" data-variant="ghost">Cancel</a>
          </div>
        </form>
      </section>
    </div>
  </div>
</Base>
