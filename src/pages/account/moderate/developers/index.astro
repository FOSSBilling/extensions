---
import Base from '../../../../layouts/Base.astro';
import { requireModerator } from '@/lib/auth-guard';
import { createApiClient } from '@/lib/api/client';
import { isSafeHttpUrl } from '@/lib/safe-url';
import type { DeveloperProfile } from '@/lib/api/client';
import { CircleCheck } from '@lucide/astro';
import ProfileTrustBadge from '@/components/ProfileTrustBadge.astro';

const env = Astro.locals.env;
const guard = await requireModerator(Astro, env);
if (guard instanceof Response) return guard;
const user = guard;

const view =
  Astro.url.searchParams.get('view') === 'all' ? 'all' : 'unapproved';

const api = createApiClient(env, user.sub);
let developers: DeveloperProfile[] = [];
let loadError = false;
try {
  developers =
    view === 'all'
      ? await api.listAllDevelopers()
      : await api.listUnapprovedDevelopers();
} catch {
  loadError = true;
}
---

<Base title="Developer profiles — FOSSBilling Extensions">
  <div class="max-w-3xl mx-auto space-y-6">
    <div class="flex items-center justify-between gap-4">
      <h1 class="text-2xl font-semibold tracking-tight">Developer profiles</h1>
      <div class="flex items-center gap-2">
        <a
          href="/account/moderate/developers/claims"
          class="btn"
          data-size="sm"
          data-variant="outline"
        >
          Claims Queue
        </a>
        <a
          href="/account/moderate"
          class="btn"
          data-size="sm"
          data-variant="outline"
        >
          Extension Queue
        </a>
      </div>
    </div>

    <nav class="flex gap-2">
      {
        (['unapproved', 'all'] as const).map((v) => (
          <a
            href={`/account/moderate/developers?view=${v}`}
            class="btn"
            data-size="sm"
            data-variant={v === view ? 'primary' : 'outline'}
          >
            {v === 'unapproved' ? 'Awaiting Review' : 'All Profiles'}
          </a>
        ))
      }
    </nav>

    <p class="text-sm text-muted-foreground">
      These profiles are already live — approval is a trust badge, not a publish
      gate. An edit to an approved profile clears its badge again until it's
      reviewed here, unless the profile is currently GitHub verified.
    </p>

    {
      loadError ? (
        <p class="text-sm text-destructive">
          Unable to load developer profiles right now.
        </p>
      ) : developers.length === 0 ? (
        <p class="text-muted-foreground text-sm">
          {view === 'unapproved'
            ? 'No developer profiles awaiting review.'
            : 'No developer profiles yet.'}
        </p>
      ) : (
        <ul class="space-y-4">
          {developers.map((d) => (
            // overflow-visible: basecoat's .card sets overflow-hidden (to
            // clip a first/last-child image to its rounded corners, not
            // relevant here) which otherwise clips ProfileTrustBadge's
            // tooltip — see the same fix on /account.
            <li class="card overflow-visible">
              <header class="flex items-start justify-between gap-4">
                <div>
                  <h2 class="font-semibold flex items-center gap-2">
                    {d.name} ({d.id})
                    <ProfileTrustBadge
                      approved={d.approved}
                      githubOrgVerified={d.github_org_verified}
                      githubVerifiedAt={d.github_verified_at}
                    />
                    {d.unclaimed && (
                      <span class="badge" data-variant="secondary">
                        Unclaimed
                      </span>
                    )}
                  </h2>
                  <p class="text-sm text-muted-foreground">
                    {d.type}
                    {d.URL && (
                      <>
                        {' '}
                        &middot;{' '}
                        {isSafeHttpUrl(d.URL) ? (
                          <a href={d.URL}>{d.URL}</a>
                        ) : (
                          d.URL
                        )}
                        {d.github_url_verified && (
                          <CircleCheck
                            class="size-3.5 inline text-primary align-text-bottom"
                            title="Matches GitHub's on-file website"
                          />
                        )}
                      </>
                    )}
                  </p>
                  {d.owner_name && (
                    <p class="text-sm text-muted-foreground">
                      Owned by <strong>{d.owner_name}</strong>
                      {d.owner_github_login && (
                        <>
                          {' '}
                          (
                          <a
                            href={`https://github.com/${d.owner_github_login}`}
                          >
                            @{d.owner_github_login}
                          </a>
                          )
                        </>
                      )}
                    </p>
                  )}
                </div>
                <div class="flex items-center gap-2">
                  <a
                    href={`/account/moderate/developers/${d.id}/history`}
                    class="btn"
                    data-size="sm"
                    data-variant="outline"
                  >
                    History
                  </a>
                  {!d.approved && (
                    <form
                      method="POST"
                      action={`/account/moderate/developers/${d.id}/approve`}
                    >
                      <input
                        type="hidden"
                        name="expected_revision"
                        value={d.content_revision}
                      />
                      <button type="submit" class="btn" data-size="sm">
                        Approve
                      </button>
                    </form>
                  )}
                </div>
              </header>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</Base>
