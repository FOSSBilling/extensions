---
import Base from '../../../../../layouts/Base.astro';
import { requireModerator } from '@/lib/auth-guard';
import { createApiClient } from '@/lib/api/client';
import type { PendingDeveloperClaim } from '@/lib/api/client';
import RejectDialog from '@/components/RejectDialog.astro';
import { formatDate } from '@/lib/format-date';

const env = Astro.locals.env;
const guard = await requireModerator(Astro, env);
if (guard instanceof Response) return guard;
const user = guard;

const api = createApiClient(env, user.sub);
let claims: PendingDeveloperClaim[] = [];
let loadError = false;
try {
  claims = await api.listPendingClaims();
} catch {
  loadError = true;
}
---

<Base title="Developer profile claims — FOSSBilling Extensions">
  <div class="max-w-3xl mx-auto space-y-6">
    <div class="flex items-center justify-between gap-4">
      <h1 class="text-2xl font-semibold tracking-tight">
        Profile Claims Awaiting Review
      </h1>
      <a href="/account/moderate/developers" class="btn" data-variant="outline">
        Developer Profiles
      </a>
    </div>

    <p class="text-sm text-muted-foreground">
      These profiles have no linked account. Approving gives the claimant
      ownership immediately. A "GitHub verified" badge means the claimant's own
      linked GitHub account was automatically confirmed to match this
      developer's GitHub org/username — otherwise, use the note below (and the
      profile's public page) to judge legitimacy yourself.
    </p>

    {
      loadError ? (
        <p class="text-sm text-destructive">
          Unable to load pending claims right now.
        </p>
      ) : claims.length === 0 ? (
        <p class="text-muted-foreground text-sm">
          No profile claims awaiting review.
        </p>
      ) : (
        <ul class="space-y-4">
          {claims.map((c) => (
            <li class="card space-y-3">
              <header>
                <h2 class="font-semibold flex items-center gap-2">
                  {c.developer_name} ({c.developer_id})
                  {c.github_org_verified && (
                    <span class="badge">GitHub verified</span>
                  )}
                </h2>
                <p class="text-sm text-muted-foreground">
                  {c.developer_type} &middot; claimed by{' '}
                  <strong>{c.claimant_name ?? c.claimant_id}</strong>
                  {c.claimant_github_login && (
                    <>
                      {' '}
                      (
                      <a href={`https://github.com/${c.claimant_github_login}`}>
                        @{c.claimant_github_login}
                      </a>
                      )
                    </>
                  )}{' '}
                  on {formatDate(c.created_at)}
                </p>
                {c.note && <p class="text-sm mt-1">&ldquo;{c.note}&rdquo;</p>}
              </header>
              <footer class="flex items-center gap-3 flex-wrap">
                <form
                  method="POST"
                  action={`/account/moderate/developers/claims/${c.id}/approve`}
                >
                  <button type="submit" class="btn" data-size="sm">
                    Approve
                  </button>
                </form>
                <button
                  type="button"
                  class="btn"
                  data-size="sm"
                  data-variant="destructive"
                  onclick={`document.getElementById('reject-claim-${c.id}').showModal()`}
                >
                  Reject
                </button>
              </footer>

              <RejectDialog
                id={`reject-claim-${c.id}`}
                title={`Reject claim on "${c.developer_id}"?`}
                description="The claimant will see this reason."
                formAction={`/account/moderate/developers/claims/${c.id}/reject`}
              />
            </li>
          ))}
        </ul>
      )
    }
  </div>
</Base>
