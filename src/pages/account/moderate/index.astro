---
import { X } from '@lucide/astro';
import Base from '../../../layouts/Base.astro';
import { requireModerator } from '@/lib/auth-guard';
import {
  ApiRequestError,
  createApiClient,
  getApiErrorMessage,
} from '@/lib/api/client';
import type { ExtensionRevision, RevisionStatus } from '@/lib/api/client';
import RejectDialog from '@/components/RejectDialog.astro';
import { formatDate } from '@/lib/format-date';
import { cursorPageUrl } from '@/lib/pagination';

const env = Astro.locals.env;
const guard = await requireModerator(Astro, env);
if (guard instanceof Response) return guard;
const user = guard;

const statusParam = Astro.url.searchParams.get('status');
const status: RevisionStatus =
  statusParam === 'approved' || statusParam === 'rejected'
    ? statusParam
    : 'pending';

const api = createApiClient(env, user.sub);
let revisions: ExtensionRevision[] = [];
let nextCursor: string | null = null;
let hasMore = false;
let loadError: string | null = null;
try {
  const page = await api.listModerationQueue(status, {
    cursor: Astro.url.searchParams.get('cursor') ?? undefined,
  });
  revisions = page.result;
  nextCursor = page.pagination.next_cursor;
  hasMore = page.pagination.has_more;
} catch (error) {
  loadError =
    error instanceof ApiRequestError
      ? getApiErrorMessage(error)
      : 'Unable to load the moderation queue right now.';
}

const nextPageUrl =
  hasMore && nextCursor !== null && nextCursor.length > 0
    ? cursorPageUrl(Astro.url, 'cursor', nextCursor)
    : null;
---

<Base title="Moderation Queue — FOSSBilling Extensions">
  <div class="max-w-3xl mx-auto space-y-6">
    <div class="flex items-center justify-between gap-4">
      <h1 class="text-2xl font-semibold tracking-tight">Moderation Queue</h1>
      <a href="/account/moderate/developers" class="btn" data-variant="outline">
        Developer Profiles
      </a>
    </div>

    <details class="card">
      <summary class="p-4 cursor-pointer font-semibold">
        Delist a published extension
      </summary>
      <div class="p-4 pt-0">
        <p class="text-sm text-muted-foreground mb-3">
          Removes an already-published extension from the public catalogue — for
          a broken or abandoned listing, not a pending edit. Its content and
          history are kept, and its owner can still see why.
        </p>
        <form id="delist-form" class="flex flex-col gap-3">
          <div class="field">
            <label for="delist-id">Extension id</label>
            <input
              class="input"
              type="text"
              id="delist-id"
              placeholder="e.g. paygate"
              required
            />
          </div>
          <div class="field">
            <label for="delist-reason">Reason</label>
            <textarea
              class="textarea"
              id="delist-reason"
              placeholder="Why is this being removed? The owner will see this."
              required></textarea>
          </div>
          <button
            type="submit"
            class="btn self-start"
            data-variant="destructive"
          >
            Delist
          </button>
        </form>
      </div>
    </details>

    <dialog
      id="delist-confirm-dialog"
      class="dialog"
      aria-labelledby="delist-confirm-title"
      aria-describedby="delist-confirm-description"
      onclick="if (arguments[0].target === this) this.close()"
    >
      <form method="POST" action="/account/moderate/delist">
        <header>
          <h2 id="delist-confirm-title">
            Delist "<span id="delist-confirm-id"></span>"?
          </h2>
          <p id="delist-confirm-description">
            It will be removed from the public catalogue immediately. The owner
            can still see it, and why, in their dashboard.
          </p>
        </header>
        <footer>
          <button
            type="button"
            class="btn"
            data-variant="outline"
            onclick="this.closest('dialog').close()"
          >
            Cancel
          </button>
          <button type="submit" class="btn" data-variant="destructive">
            Delist
          </button>
        </footer>
        <input type="hidden" name="id" id="delist-hidden-id" />
        <input type="hidden" name="reason" id="delist-hidden-reason" />
        <button
          type="button"
          class="btn"
          data-variant="ghost"
          data-size="icon-sm"
          aria-label="Close dialog"
          onclick="this.closest('dialog').close()"
        >
          <X class="size-4" />
        </button>
      </form>
    </dialog>

    <nav class="flex gap-2">
      {
        (['pending', 'approved', 'rejected'] as const).map((s) => (
          <a
            href={`/account/moderate?status=${s}`}
            class="btn"
            data-size="sm"
            data-variant={s === status ? 'primary' : 'outline'}
          >
            {s}
          </a>
        ))
      }
    </nav>

    {
      loadError ? (
        <p class="text-sm text-destructive">{loadError}</p>
      ) : (
        <>
          {revisions.length === 0 ? (
            <p class="text-muted-foreground text-sm">No {status} revisions.</p>
          ) : (
            <ul class="space-y-4">
              {revisions.map((r) => (
                <li class="card">
                  <header class="flex items-start justify-between gap-4">
                    <div>
                      <h2 class="font-semibold">
                        {r.content.name ?? r.extension_id}
                      </h2>
                      <p class="text-sm text-muted-foreground">
                        {r.extension_id} by {r.developer_id} &middot; submitted{' '}
                        {formatDate(r.created_at)}
                      </p>
                    </div>
                    {r.content.type && (
                      <span class="badge" data-variant="secondary">
                        {r.content.type}
                      </span>
                    )}
                  </header>
                  <section>
                    {r.content.description && (
                      <p class="text-sm">{r.content.description}</p>
                    )}
                    <details class="mt-2">
                      <summary class="text-sm text-muted-foreground cursor-pointer">
                        Full Content
                      </summary>
                      <pre class="text-xs mt-2 overflow-x-auto bg-muted rounded-md p-3">
                        {JSON.stringify(r.content, null, 2)}
                      </pre>
                    </details>
                    {r.status === 'pending' && (
                      <div class="flex items-center gap-3 mt-4">
                        <form
                          method="POST"
                          action={`/account/moderate/${r.extension_id}/${r.id}/approve`}
                        >
                          <button type="submit" class="btn" data-size="sm">
                            Approve
                          </button>
                        </form>
                        <button
                          type="button"
                          class="btn"
                          data-size="sm"
                          data-variant="destructive"
                          onclick={`document.getElementById('reject-revision-${r.id}').showModal()`}
                        >
                          Reject
                        </button>
                      </div>
                    )}

                    {r.status === 'pending' && (
                      <RejectDialog
                        id={`reject-revision-${r.id}`}
                        title={`Reject "${r.content.name ?? r.extension_id}"?`}
                        description="The submitter will see this reason."
                        formAction={`/account/moderate/${r.extension_id}/${r.id}/reject`}
                        reasonPlaceholder="Reason for rejection"
                      />
                    )}
                    {r.status !== 'pending' && r.review_note && (
                      <p class="text-sm text-muted-foreground mt-2">
                        Note: {r.review_note}
                      </p>
                    )}
                  </section>
                </li>
              ))}
            </ul>
          )}
          {nextPageUrl && (
            <a href={nextPageUrl} class="btn mt-4">
              Next queue page
            </a>
          )}
        </>
      )
    }
  </div>
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>('#delist-form');
  const dialog = document.querySelector<HTMLDialogElement>(
    '#delist-confirm-dialog',
  );
  const idInput = document.querySelector<HTMLInputElement>('#delist-id');
  const reasonInput =
    document.querySelector<HTMLTextAreaElement>('#delist-reason');
  const confirmId = document.querySelector('#delist-confirm-id');
  const hiddenId =
    document.querySelector<HTMLInputElement>('#delist-hidden-id');
  const hiddenReason = document.querySelector<HTMLInputElement>(
    '#delist-hidden-reason',
  );

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (!idInput || !reasonInput || !dialog || !hiddenId || !hiddenReason) {
      return;
    }
    if (confirmId) confirmId.textContent = idInput.value;
    hiddenId.value = idInput.value;
    hiddenReason.value = reasonInput.value;
    dialog.showModal();
  });
</script>
