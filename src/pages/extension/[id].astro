---
import Base from '@/layouts/Base.astro';
import OwnerExtensionView from '@/components/OwnerExtensionView.astro';
import { loadExtensionView, type ExtensionView } from '@/lib/extension-view';
import { extensionIconUrl } from '@/lib/extension-icon';
import { getSessionUser } from '@/lib/session';
import ExtensionHeader from '@/components/ExtensionHeader.astro';
import ExtensionWorkspace from '@/components/ExtensionWorkspace.astro';
import { ApiRequestError, getApiErrorMessage } from '@/lib/api/client';

const env = Astro.locals.env;
const { id } = Astro.params;

if (!id) {
  return Astro.rewrite('/404');
}

Astro.cache.set(false);
Astro.response.headers.set('Cache-Control', 'private, no-store');
let view: ExtensionView | undefined;
let detailError: string | null = null;
try {
  const user = await getSessionUser(Astro.cookies, env.sessionSecret);
  view = await loadExtensionView(env, id, user);
} catch (error) {
  if (error instanceof ApiRequestError && error.status === 404)
    return Astro.rewrite('/404');
  if (!(error instanceof ApiRequestError))
    console.error('[extension] Unable to load extension details:', error);
  detailError =
    error instanceof ApiRequestError
      ? getApiErrorMessage(error)
      : 'Extension details are temporarily unavailable. Please try again.';
  Astro.response.status =
    error instanceof ApiRequestError && error.status === 429 ? 429 : 503;
}
const ext = view?.kind === 'public' ? view.extension : undefined;
const metadata =
  view?.kind === 'owner'
    ? Astro.url.searchParams.get('version') === 'published'
      ? (view.owned.published ?? view.owned.pending_revision?.content)
      : (view.owned.pending_revision?.content ?? view.owned.published)
    : ext;
const name = metadata?.name ?? id;
// Truncate on code points to avoid splitting a Unicode surrogate pair.
const descriptionCodePoints = [...(metadata?.description ?? '')];
const shareDescription = metadata
  ? descriptionCodePoints.length > 160
    ? `${descriptionCodePoints.slice(0, 157).join('')}...`
    : metadata.description
  : (detailError ?? 'Extension details are temporarily unavailable.');
let shareImage: string | undefined;
const metadataIcon = metadata
  ? extensionIconUrl({
      ...metadata,
      id,
      source: metadata.source ?? { type: 'custom', repo: '' },
    })
  : undefined;
if (metadataIcon) {
  try {
    shareImage = new URL(metadataIcon).href;
  } catch {
    /* Omit malformed stored URLs. */
  }
}
const releasesView = Astro.url.searchParams.get('view') === 'releases';
---

<Base
  title={
    view
      ? `${name} | FOSSBilling Extensions`
      : 'Temporarily Unavailable | FOSSBilling Extensions'
  }
  description={shareDescription}
  image={shareImage}
>
  {detailError || !view ? (
    <div
      class="card flex min-h-32 flex-col items-center justify-center px-6 py-12 text-center"
      role="alert"
    >
      <h2 class="font-semibold">Extension Temporarily Unavailable</h2>
      <p class="text-muted-foreground mt-2">{detailError}</p>
      <a href={`${Astro.url.pathname}${Astro.url.search}`} class="btn mt-4">
        Try Again
      </a>
    </div>
  ) : (
    <div class="mx-auto max-w-6xl space-y-8">
      {view.kind === 'owner' ? (
        <OwnerExtensionView owned={view.owned} userId={view.userId} />
      ) : (
        <>
          <ExtensionHeader
            id={view.extension.identifier}
            content={view.extension}
            developer={view.extension.developer}
          />
          <ExtensionWorkspace
            id={view.extension.identifier}
            content={view.extension}
            developerName={view.extension.developer.name}
            releases={releasesView}
          />
        </>
      )}
    </div>
  )}
</Base>
