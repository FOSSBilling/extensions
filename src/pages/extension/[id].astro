---
import Base from '@/layouts/Base.astro';
import ExtensionHeader from '@/components/ExtensionHeader.astro';
import DetailsCard from '@/components/DetailsCard.astro';
import ReleasesCard from '@/components/ReleasesCard.astro';
import Overview from '@/components/Overview.astro';
import ReleasesTable from '@/components/ReleasesTable.astro';
import { ApiRequestError, getExtensionById } from '@/lib/api/client';

const env = Astro.locals.env;
const { id } = Astro.params;

if (!id) {
  return Astro.rewrite('/404');
}

let ext;
try {
  ext = await getExtensionById(env, id);
} catch (error) {
  if (error instanceof ApiRequestError && error.status === 404) {
    return Astro.rewrite('/404');
  }
  throw error;
}

if (!ext) {
  return Astro.rewrite('/404');
}

// Truncate on code points — UTF-16 slice() can split a surrogate pair and
// leave a lone surrogate in the shared metadata.
const descriptionCodePoints = [...ext.description];
const shareDescription =
  descriptionCodePoints.length > 160
    ? `${descriptionCodePoints.slice(0, 157).join('')}...`
    : ext.description;
// og:image uses the original icon rather than the 64x64 icon variant:
// social scrapers want the largest available image for large-card previews.
// Stored URLs arrive unvalidated from upstream, and Base builds the share
// URL with `new URL(image, Astro.site)` — which throws on malformed input
// and would 500 the whole page — so only pass cleanly-parseable URLs.
let shareImage: string | undefined;
if (ext.icon_url) {
  try {
    shareImage = new URL(ext.icon_url).href;
  } catch {
    // Malformed stored URL: omit the social image rather than fail render.
  }
}
---

<Base
  title={`${ext.name} | FOSSBilling Extensions`}
  description={shareDescription}
  image={shareImage}
>
  <ExtensionHeader ext={ext} />

  <div class="tabs mt-6" id="extension-tabs">
    <nav
      role="tablist"
      aria-orientation="horizontal"
      aria-label="Extension tabs"
    >
      <button
        type="button"
        role="tab"
        id="overview-tab"
        aria-selected="true"
        aria-controls="overview-panel"
        tabindex="0"
      >
        Overview
      </button>
      <button
        type="button"
        role="tab"
        id="release-history-tab"
        aria-selected="false"
        aria-controls="release-history-panel"
        tabindex="0"
      >
        Release History
      </button>
    </nav>

    <div class="grid gap-6 lg:grid-cols-6 mt-6">
      <div class="lg:col-span-4">
        <article class="card h-full">
          <div class="h-full">
            <div
              role="tabpanel"
              id="overview-panel"
              class="p-6"
              aria-labelledby="overview-tab"
              tabindex="-1"
              aria-selected="true"
            >
              <Overview ext={ext} />
            </div>
            <div
              role="tabpanel"
              id="release-history-panel"
              class="p-6"
              aria-labelledby="release-history-tab"
              tabindex="-1"
              aria-selected="false"
              hidden
            >
              <ReleasesTable ext={ext} />
            </div>
          </div>
        </article>
      </div>

      <div class="lg:col-span-2 space-y-6">
        <DetailsCard ext={ext} />
        <ReleasesCard ext={ext} />
      </div>
    </div>
  </div>
</Base>
