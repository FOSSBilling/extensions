---
import '@/styles/global.css';
import LogoLight from '@/assets/logo-light.svg';
import LogoDark from '@/assets/logo-dark.svg';
import Container from '@/components/Container.astro';
import FlashToaster from '@/components/FlashToaster.astro';
import HeaderAccount from '@/components/HeaderAccount.astro';
import { Sun, Moon } from '@lucide/astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { title, description, image } = Astro.props;

const DEFAULT_DESCRIPTION =
  'Browse, filter, and install community extensions for FOSSBilling.';
const shareDescription = description ?? DEFAULT_DESCRIPTION;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
// Open Graph/Twitter images must be absolute; the images route returns paths.
const shareImageUrl = image ? new URL(image, Astro.site).href : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem('themeMode');
          if (
            stored
              ? stored === 'dark'
              : matchMedia('(prefers-color-scheme: dark)').matches
          ) {
            document.documentElement.classList.add('dark');
          }
        } catch (_) {}

        const apply = (dark) => {
          document.documentElement.classList.toggle('dark', dark);
          try {
            localStorage.setItem('themeMode', dark ? 'dark' : 'light');
          } catch (_) {}
        };

        document.addEventListener('basecoat:theme', (event) => {
          const mode = event.detail?.mode;
          apply(
            mode === 'dark'
              ? true
              : mode === 'light'
                ? false
                : !document.documentElement.classList.contains('dark'),
          );
        });
      })();
    </script>
    <script>
      import 'basecoat-css/basecoat';
      import 'basecoat-css/dropdown-menu';
      import 'basecoat-css/toast';

      // Only extension detail pages use tabs and only the submission form
      // uses the license combobox; load their JS on demand so catalogue
      // pages never download it. Module scripts run after parsing, so the
      // markup is present by the time these checks execute.
      if (document.querySelector('.tabs')) {
        import('basecoat-css/tabs');
      }
      if (document.querySelector('.combobox')) {
        import('basecoat-css/combobox');
      }
    </script>
    <title>{title}</title>
    <meta name="description" content={shareDescription} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:site_name" content="FOSSBilling Extensions" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={shareDescription} />
    <meta property="og:url" content={canonicalUrl} />
    {shareImageUrl && <meta property="og:image" content={shareImageUrl} />}
    <meta
      name="twitter:card"
      content={shareImageUrl ? 'summary_large_image' : 'summary'}
    />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={shareDescription} />
    {shareImageUrl && <meta name="twitter:image" content={shareImageUrl} />}
  </head>
  <body class="bg-background">
    <header class="border-b border-border sticky top-0 z-50 bg-background/95 backdrop-blur supports-[backdrop-filter]:bg-background/60">
      <Container class="flex h-18 items-center justify-between">
        <div class="flex items-center">
          <a href="/" aria-label="FOSSBilling Extensions Home">
            <LogoLight class="h-8 w-auto dark:hidden" />
            <LogoDark class="h-8 w-auto hidden dark:block" />
          </a>
          <span class="ml-3 pl-3 border-s text-sm font-semibold uppercase tracking-wider">
            Extensions
          </span>
          <span class="ml-2 badge" data-variant="secondary">
            beta
          </span>
        </div>
        <div class="flex items-center gap-3">
          <HeaderAccount server:defer />
          <button
            type="button"
            aria-label="Toggle Dark Mode"
            data-tooltip="Toggle Dark Mode"
            data-side="bottom"
            data-align="end"
            onclick="document.dispatchEvent(new CustomEvent('basecoat:theme'))"
            class="btn"
            data-size="icon-sm"
            data-variant="outline"
          >
            <Sun class="w-5 h-5 hidden dark:block" aria-hidden="true" />
            <Moon class="w-5 h-5 block dark:hidden" aria-hidden="true" />
          </button>
        </div>
      </Container>
    </header>
    <div
      id="toaster"
      class="toaster"
      role="region"
      aria-live="polite"
      aria-label="Notifications"
    >
      <FlashToaster server:defer />
    </div>
    <main>
      <Container class="py-6 sm:py-10">
        <slot />
      </Container>
    </main>
    <footer class="border-t border-border py-8">
      <Container class="text-center text-sm text-muted-foreground">
        <p>&copy; 2026 &mdash; The FOSSBilling project.</p>
      </Container>
    </footer>
  </body>
</html>
