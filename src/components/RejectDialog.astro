---
import DialogShell from '@/components/DialogShell.astro';
import NotifyField from '@/components/NotifyField.astro';

interface Props {
  id: string;
  title: string;
  description: string;
  formAction: string;
  reasonPlaceholder?: string;
  notifyRecipient?: 'author' | 'owner' | 'claimant';
}

const {
  id,
  title,
  description,
  formAction,
  reasonPlaceholder = 'Reason for rejecting',
  notifyRecipient = 'author',
} = Astro.props;
---

<DialogShell
  id={id}
  title={title}
  description={description}
  formAction={formAction}
  submitLabel="Reject"
  submitVariant="destructive"
>
  <div class="field">
    <label for={`${id}-note`}>Reason</label>
    <input
      class="input"
      type="text"
      id={`${id}-note`}
      name="review_note"
      placeholder={reasonPlaceholder}
      required
    />
  </div>
  <NotifyField id={`${id}-notify`} recipient={notifyRecipient} />
</DialogShell>
