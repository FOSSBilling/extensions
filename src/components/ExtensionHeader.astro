---
import type { StoredExtensionFields } from '@/lib/extensions-data';
import type { Developer } from '@/types';
import { latestRelease } from '@/lib/releases';
import { ArrowLeft, Download, Package, User } from '@lucide/astro';
import { getSignedImageUrl } from '@/lib/signed-image-url';
import { directoryAssetAvifUrl } from '@/lib/image-url';
import { extensionIconUrl } from '@/lib/extension-icon';
import { releaseDownloadHref } from '@/lib/extension-package';
import { isSafeHttpUrl } from '@/lib/safe-url';
interface Props {
  id: string;
  content: StoredExtensionFields;
  developer: Pick<Developer, 'identifier' | 'name'>;
  versionLabel?: string;
  backHref?: string;
  backLabel?: string;
}
const {
  id,
  content,
  developer,
  versionLabel = 'Latest Release',
  backHref = '/',
  backLabel = 'Extensions',
} = Astro.props;
const latest = latestRelease(content.releases ?? []);
const version = latest?.tag ?? content.version;
const iconUrl = await getSignedImageUrl(
  extensionIconUrl(content),
  'icon',
  Astro.locals.env.sessionSecret,
);
const downloadUrl = latest
  ? new URL(releaseDownloadHref(latest), Astro.url).href
  : content.download_url;
---

<a
  href={backHref}
  class="inline-flex items-center gap-2 text-sm text-muted-foreground hover:text-foreground"
>
  <ArrowLeft class="size-4" aria-hidden="true" />
  {backLabel}
</a>
<header class="flex flex-col gap-6 sm:flex-row sm:items-start sm:justify-between">
  <div class="flex min-w-0 items-start gap-4">
    <div class="flex size-16 shrink-0 items-center justify-center rounded-xl border bg-muted/50">
      <picture>
        <source
          data-extension-icon-avif
          type="image/avif"
          srcset={directoryAssetAvifUrl(iconUrl)}
        />
        <img
          data-extension-icon
          data-extension-icon-source={iconUrl}
          src={iconUrl}
          hidden={!iconUrl}
          width="48"
          height="48"
          alt=""
          class="size-12 object-contain"
          decoding="async"
        />
      </picture>
      <span data-extension-icon-fallback hidden={Boolean(iconUrl)}>
        <Package class="size-7 text-muted-foreground" aria-hidden="true" />
      </span>
    </div>
    <div class="min-w-0 space-y-2">
      <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
        Extension Overview
      </p>
      <div class="flex flex-wrap items-center gap-3">
        <h1
          data-extension-name
          class="break-words text-2xl font-semibold tracking-tight sm:text-3xl"
        >
          {content.name ?? id}
        </h1>
        <span
          class="text-lg text-muted-foreground"
          data-extension-version
          hidden={!version}
        >
          <span class="sr-only">{versionLabel} </span>
          <span data-extension-version-value>
            {version && /^\d/.test(version) ? `v${version}` : version}
          </span>
        </span>
        <slot name="status" />
      </div>
      <p class="flex flex-wrap items-center gap-2 text-sm text-muted-foreground">
        <a
          href={`/developer/${developer.identifier}`}
          class="inline-flex items-center gap-1.5 underline-offset-4 hover:underline"
          data-astro-prefetch="false"
        >
          <User class="size-3.5" aria-hidden="true" />
          {developer.name}
        </a>
        <span aria-hidden="true">/</span>
        <span class="break-all">{id}</span>
      </p>
    </div>
  </div>
  <a
    data-extension-download
    hidden={!isSafeHttpUrl(downloadUrl)}
    href={isSafeHttpUrl(downloadUrl) ? downloadUrl : undefined}
    class="btn shrink-0 self-start"
    target="_blank"
    rel="noopener noreferrer"
  >
    <Download class="size-4" aria-hidden="true" />
    Download
  </a>
</header>
