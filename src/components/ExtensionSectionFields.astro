---
import type { ExtensionUpdate } from '@/lib/api/client';
import type { DraftSection } from '@/lib/extension-draft';
import {
  EXTENSION_TYPES,
  SPDX_LICENSE_IDS,
  EXTENSION_TYPE_LABELS,
  repositoryURL,
} from '@/types';
import { OTHER_LICENSE } from '@/lib/extension-form';
interface Props {
  section: DraftSection;
  content: ExtensionUpdate;
}
const { section, content } = Astro.props;
---

{section === 'listing' && (
  <>
    <label class="grid gap-2 text-sm font-medium">
      Name
      <input
        class="input w-full"
        name="name"
        required
        maxlength="120"
        value={content.name}
      />
    </label>
    <label class="grid gap-2 text-sm font-medium">
      Short Description
      <textarea
        class="textarea w-full"
        name="description"
        rows="3"
        required
        maxlength="4000"
      >{content.description}</textarea>
    </label>
    <label class="grid gap-2 text-sm font-medium">
      Extension Type
      <select class="select w-full" name="type">
        {EXTENSION_TYPES.map((type) => (
          <option value={type} selected={content.type === type}>
            {EXTENSION_TYPE_LABELS[type]}
          </option>
        ))}
      </select>
    </label>
    <label class="grid gap-2 text-sm font-medium">
      Homepage
      <input
        class="input w-full"
        name="homepage_url"
        type="url"
        value={content.homepage_url}
      />
    </label>
    <label class="grid gap-2 text-sm font-medium">
      Icon Path <span class="font-normal text-muted-foreground">Optional</span>
      <input
        class="input w-full"
        name="icon_url"
        type="text"
        value={content.icon_url}
      />
    </label>
  </>
)}
{section === 'listing' && (
  <>
    <label class="grid gap-2 text-sm font-medium">
      Author Name
      <input
        class="input w-full"
        name="author_name"
        required
        maxlength="200"
        value={content.author.name}
      />
    </label>
    <label class="grid gap-2 text-sm font-medium">
      Author URL <span class="font-normal text-muted-foreground">Optional</span>
      <input
        class="input w-full"
        type="url"
        name="author_url"
        value={content.author.url}
      />
    </label>
    <p class="text-xs text-muted-foreground">
      Manage compatibility for each version in the Releases tab.
    </p>
  </>
)}
{section === 'readme' && (
  <>
    <label class="grid gap-2 text-sm font-medium">
      README (Markdown)
      <textarea
        class="textarea w-full min-h-72 font-mono text-sm"
        name="readme"
        rows="14"
        required
        maxlength="100000"
      >{content.readme}</textarea>
    </label>
    <p class="text-xs text-muted-foreground">
      Save to draft to preview your README below.
    </p>
  </>
)}
{section === 'listing' && (
  <>
    <label class="grid gap-2 text-sm font-medium">
      Source URL
      <input
        class="input w-full"
        type="url"
        name="source_url"
        required
        maxlength="2048"
        value={content.source.repo ? repositoryURL(content.source) : ''}
        placeholder="https://github.com/owner/project"
      />
    </label>
    <label class="grid gap-2 text-sm font-medium">
      License
      <select class="select w-full" name="license_spdx_id">
        {SPDX_LICENSE_IDS.map((id) => (
          <option value={id} selected={content.license === id}>
            {id}
          </option>
        ))}
        <option
          value={OTHER_LICENSE}
          selected={!SPDX_LICENSE_IDS.includes(content.license)}
        >
          Other / Proprietary
        </option>
      </select>
    </label>
    <label
      class="grid gap-2 text-sm font-medium"
      data-custom-license
      hidden={SPDX_LICENSE_IDS.includes(content.license)}
    >
      Custom License Name
      <input
        class="input w-full"
        name="license_name_custom"
        value={
          SPDX_LICENSE_IDS.includes(content.license)
            ? undefined
            : content.license
        }
        maxlength="1000"
      />
    </label>
  </>
)}
