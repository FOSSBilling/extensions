---
import type { Extension } from '@/types';
import { renderMarkdown } from '@/lib/markdown';

interface Props {
  ext: Extension;
}

const { ext } = Astro.props;
const readmeHtml = renderMarkdown(
  ext.readme || 'No README is available for this version.',
);
---

<div class="markdown-body break-words" set:html={readmeHtml} />
