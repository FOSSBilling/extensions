---
import { CircleCheck, CircleX, Info, TriangleAlert } from '@lucide/astro';

interface Props {
  category?: 'success' | 'error' | 'info' | 'warning';
  title: string;
  description?: string;
  action?: { label: string; href: string };
}

const { category = 'success', title, description, action } = Astro.props;

const Icon = {
  success: CircleCheck,
  error: CircleX,
  info: Info,
  warning: TriangleAlert,
}[category];
---

<div
  class="toast"
  role={category === 'error' ? 'alert' : 'status'}
  aria-atomic="true"
  data-category={category}
  data-duration="-1"
>
  <div class="toast-content">
    <Icon aria-hidden="true" />
    <section>
      <h2>{title}</h2>
      {description && <p>{description}</p>}
    </section>
    <footer>
      {action && (
        <a href={action.href} class="btn" data-toast-action>
          {action.label}
        </a>
      )}
      <button type="button" class="btn" data-toast-action>
        Dismiss
      </button>
    </footer>
  </div>
</div>
