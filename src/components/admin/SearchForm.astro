---
// GET-style `?q=` search that keeps the page's other params. One delegated
// listener covers every instance; empty input clears `q`. Params named in
// `resetParams` are always dropped — cursors a new search would strand.
interface Props {
  placeholder: string;
  value?: string;
  resetParams?: string[];
}

const { placeholder, value, resetParams = [] } = Astro.props;
---

<form
  data-search-form
  data-reset-params={resetParams.length > 0 ? resetParams.join(',') : undefined}
  class="flex gap-2"
  role="search"
  aria-label={placeholder}
>
  <input
    class="input"
    type="text"
    name="q"
    placeholder={placeholder}
    value={value ?? ''}
  />
  <button type="submit" class="btn" data-size="sm" data-variant="outline">
    Search
  </button>
</form>

<script>
  const flags = window as unknown as { adminSearchFormInit?: boolean };
  if (!flags.adminSearchFormInit) {
    flags.adminSearchFormInit = true;
    document.addEventListener('submit', (event) => {
      const form = (event.target as Element | null)?.closest(
        'form[data-search-form]',
      );
      if (!form) return;
      event.preventDefault();
      const url = new URL(window.location.href);
      const query = new FormData(form as HTMLFormElement)
        .get('q')
        ?.toString()
        .trim();
      if (query) {
        url.searchParams.set('q', query);
      } else {
        url.searchParams.delete('q');
      }
      const reset = (form.getAttribute('data-reset-params') ?? '')
        .split(',')
        .filter(Boolean);
      for (const name of reset) {
        url.searchParams.delete(name);
      }
      window.location.href = url.pathname + url.search;
    });
  }
</script>
