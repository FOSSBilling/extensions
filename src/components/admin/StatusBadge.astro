---
interface Props {
  status:
    | 'published'
    | 'delisted'
    | 'never-published'
    | 'pending'
    | 'approved'
    | 'rejected'
    | 'new';
  label?: string;
}

const { status, label } = Astro.props;

const variant: Record<Props['status'], string | undefined> = {
  published: undefined,
  delisted: 'destructive',
  'never-published': 'secondary',
  pending: 'secondary',
  approved: undefined,
  // Neutral, not destructive: a rejected edit leaves already-live content
  // untouched, so red would read as "removed". Destructive stays reserved
  // for delisted — content actually pulled from public view.
  rejected: 'secondary',
  new: undefined,
};

const fallback: Record<Props['status'], string> = {
  published: 'Published',
  delisted: 'Delisted',
  'never-published': 'Never Published',
  pending: 'Pending',
  approved: 'Approved',
  rejected: 'Rejected',
  new: 'New',
};
---

<span class="badge" data-variant={variant[status]}>
  {label ?? fallback[status]}
</span>
