---
interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
---

<div class="card p-8 text-center space-y-2">
  <p class="font-medium">{title}</p>
  {description && <p class="text-sm text-muted-foreground">{description}</p>}
  <div class="pt-1">
    <slot />
  </div>
</div>
