---
import { formatDateTime } from '@/lib/format-date';
import type { ExtensionRevisionSummary } from '@/lib/api/client';
import StatusBadge from './StatusBadge.astro';

// Tooltip for the decision badge: "Approved on <date>." today, expanding to
// "Approved on <date>, by <user>." once reviewer names are exposed (the API
// already records reviewer_id on every decision).
function decisionTitle(
  status: 'approved' | 'rejected',
  reviewedAt: string | null,
  reviewerName: string | null = null,
): string | undefined {
  if (!reviewedAt) return undefined;
  const verb = status === 'approved' ? 'Approved' : 'Rejected';
  const when = `on ${formatDateTime(reviewedAt)}`;
  return reviewerName
    ? `${verb} ${when}, by ${reviewerName}.`
    : `${verb} ${when}.`;
}

// Audit view for decided (approved/rejected) revisions: dense rows with the
// decision, dates, and note at a glance, plus an expandable frozen-content
// row showing exactly what was reviewed. The toggle is wired by the shared
// queue client script via [data-frozen] (labels from data-show/data-hide).
interface Props {
  revisions: ExtensionRevisionSummary[];
  status: 'approved' | 'rejected';
}

const { revisions, status } = Astro.props;
// Rejections have a dedicated note column. Approved correction notes stay
// in the summary so compacted bodies cannot hide the review metadata.
const showNote = status === 'rejected';
const DETAIL_COLUMNS = showNote ? 5 : 4;
---

<div class="card overflow-x-auto p-0">
  <table class="w-full text-sm table-fixed">
    <thead>
      <tr class="text-left text-muted-foreground border-b border-border">
        <th class="px-4 py-2 font-medium">Extension</th>
        <th class="px-4 py-2 font-medium whitespace-nowrap w-28">Version</th>
        <th class="px-4 py-2 font-medium whitespace-nowrap w-28">Status</th>
        {showNote && <th class="px-4 py-2 font-medium">Note</th>}
        <th class="px-4 py-2 font-medium whitespace-nowrap w-[192px]">
          Actions
        </th>
      </tr>
    </thead>
    <tbody class="divide-y divide-border">
      {revisions.map((r) => {
        return (
          <>
            <tr data-extension-id={r.extension_id} data-revision-id={r.id}>
              <td class="px-4 py-2">
                <p class="font-medium">
                  <a
                    href={`/account/admin/extensions/${r.extension_id}`}
                    title={`Submitted on ${formatDateTime(r.created_at)}.`}
                  >
                    {r.name ?? r.extension_id}
                  </a>
                </p>
                <p class="text-xs text-muted-foreground">{r.extension_id}</p>
                {!showNote && r.review_note && (
                  <p
                    class="text-xs text-muted-foreground truncate"
                    title={r.review_note}
                  >
                    Note: {r.review_note}
                  </p>
                )}
              </td>
              <td class="px-4 py-2 text-muted-foreground whitespace-nowrap">
                {r.version?.trim() || '—'}
              </td>
              <td class="px-4 py-2 whitespace-nowrap">
                <span
                  title={decisionTitle(
                    r.status === 'approved' ? 'approved' : 'rejected',
                    r.reviewed_at,
                  )}
                >
                  <StatusBadge
                    status={r.status === 'approved' ? 'approved' : 'rejected'}
                  />
                </span>
              </td>
              {showNote && (
                <td
                  class="px-4 py-2 text-muted-foreground max-w-64 truncate"
                  title={r.review_note ?? undefined}
                >
                  {r.review_note ?? '—'}
                </td>
              )}
              <td class="px-4 py-2 whitespace-nowrap">
                <button
                  type="button"
                  class="btn px-0"
                  data-size="sm"
                  data-variant="ghost"
                  data-frozen
                  disabled={!r.content_available}
                  data-show="Show Reviewed Content"
                  data-hide="Hide Reviewed Content"
                  aria-expanded="false"
                  aria-controls={`frozen-wrap-${r.id}`}
                >
                  {r.content_available
                    ? 'Show Reviewed Content'
                    : r.compacted_at
                      ? 'Content No Longer Retained'
                      : 'Content Unavailable'}
                </button>
              </td>
            </tr>
            <tr data-frozen-wrap hidden id={`frozen-wrap-${r.id}`}>
              <td colspan={DETAIL_COLUMNS} class="px-4 py-3 bg-muted/30">
                <div class="space-y-2">
                  <p
                    class="text-sm text-destructive"
                    data-frozen-error
                    hidden
                  ></p>
                  <table class="w-full text-sm table-fixed">
                    <thead>
                      <tr>
                        <th class="text-left py-1 pr-3 w-32">Field</th>
                        <th class="text-left py-1">Reviewed Content</th>
                      </tr>
                    </thead>
                    <tbody data-frozen-body></tbody>
                  </table>
                </div>
              </td>
            </tr>
          </>
        );
      })}
    </tbody>
  </table>
</div>
