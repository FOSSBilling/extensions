---
import DialogShell from './DialogShell.astro';

// Destructive deletion confirm: DialogShell with type-to-confirm enabled.
// The submit button stays disabled until the exact confirm text is typed;
// closing resets the form and re-disables the button (DialogShell's onclose).
interface Props {
  id: string;
  title: string;
  description: string;
  confirmText: string;
  intentField?: { name: string; value: string };
  formAction?: string;
  submitLabel?: string;
}

const {
  id,
  title,
  description,
  confirmText,
  intentField,
  formAction,
  submitLabel = 'Delete',
} = Astro.props;
---

<DialogShell
  id={id}
  title={title}
  description={description}
  formAction={formAction}
  submitLabel={submitLabel}
  submitVariant="destructive"
  typeToConfirm={confirmText}
>
  {intentField && (
    <input
      slot="extra"
      type="hidden"
      name={intentField.name}
      value={intentField.value}
    />
  )}
</DialogShell>
