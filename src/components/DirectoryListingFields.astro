---
import SourceUrlField from './SourceUrlField.astro';

interface Props {
  values?: { description: string; sourceUrl: string; readme: string };
}
const { values } = Astro.props;
---

<label class="grid gap-2 text-sm font-medium">
  Short Description
  <textarea
    class="textarea w-full"
    name="description"
    rows="3"
    maxlength="500"
    required={!!values}
    placeholder={
      values ? undefined : 'Defaults to the description in manifest.json'
    }
  >{values?.description}</textarea>
</label>
<SourceUrlField value={values?.sourceUrl} />
<label class="grid gap-2 text-sm font-medium">
  README (Markdown)
  <textarea
    class="textarea w-full font-mono"
    name="readme"
    rows="12"
    maxlength="100000"
    required
  >{values?.readme}</textarea>
</label>
