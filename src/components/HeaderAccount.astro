---
// Server Island: the only per-user markup in the public page chrome. Every
// page that includes this stays free of session-dependent HTML, which is
// what makes route-level CDN caching (see routeRules in astro.config.mjs)
// safe. The component reads the session cookie itself, so it takes no props
// and needs no ASTRO_KEY. Basecoat's MutationObserver-initialized registry
// wires up the dropdown menu when this fragment is inserted.
import { CircleUser, LogIn, LogOut, ShieldUser, User } from '@lucide/astro';
import { getSessionUser } from '@/lib/session';

const user = await getSessionUser(
  Astro.cookies,
  Astro.locals.env.sessionSecret,
);
---

{user ? (
  <div class="dropdown-menu" id="account-menu">
    <button
      type="button"
      id="account-menu-trigger"
      aria-haspopup="menu"
      aria-controls="account-menu-items"
      aria-expanded="false"
      aria-label={`Account — ${user.name}`}
      data-tooltip={`Account — ${user.name}`}
      data-side="bottom"
      data-align="end"
      class="btn"
      data-size="icon-sm"
      data-variant="outline"
    >
      <CircleUser class="w-5 h-5" aria-hidden="true" />
    </button>
    <div
      id="account-menu-popover"
      data-popover
      aria-hidden="true"
      data-side="bottom"
      data-align="end"
    >
      <div
        role="menu"
        id="account-menu-items"
        aria-labelledby="account-menu-trigger"
      >
        <a
          id="account-menu-items-1"
          role="menuitem"
          href="/account"
          class="gap-2"
        >
          <User class="size-4" aria-hidden="true" />
          Account
        </a>
        {user.is_moderator && (
          <a
            id="account-menu-items-2"
            role="menuitem"
            href="/account/admin"
            class="gap-2"
          >
            <ShieldUser class="size-4" aria-hidden="true" />
            Admin
          </a>
        )}
        <div role="separator" />
        <form method="POST" action="/auth/logout" class="contents">
          <button
            id="account-menu-items-3"
            role="menuitem"
            type="submit"
            class="gap-2"
          >
            <LogOut class="size-4" aria-hidden="true" />
            Sign Out
          </button>
        </form>
      </div>
    </div>
  </div>
) : (
  <a
    href="/auth/login"
    aria-label="Developer sign-in"
    data-tooltip="Developer sign-in"
    data-side="bottom"
    data-align="end"
    class="btn"
    data-size="icon-sm"
    data-variant="outline"
    data-astro-prefetch="false"
  >
    <!-- /auth/login starts the OAuth flow (state cookies + authorization
         redirect), so hover-prefetching it would have side effects. -->
    <LogIn class="w-5 h-5" aria-hidden="true" />
  </a>
)}
