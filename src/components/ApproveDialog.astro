---
import { X } from '@lucide/astro';
import NotifyField from '@/components/NotifyField.astro';

interface Props {
  id: string;
  title: string;
  description: string;
  formAction: string;
  notifyRecipient: 'author' | 'owner' | 'claimant';
  hiddenFields?: { name: string; value: string | number }[];
}

const {
  id,
  title,
  description,
  formAction,
  notifyRecipient,
  hiddenFields = [],
} = Astro.props;
---

<dialog
  id={id}
  class="dialog"
  aria-labelledby={`${id}-title`}
  aria-describedby={`${id}-description`}
  onclick="if (arguments[0].target === this) this.close()"
  onclose="this.querySelector('form').reset()"
>
  <form method="POST" action={formAction}>
    <header>
      <h2 id={`${id}-title`}>{title}</h2>
      <p id={`${id}-description`}>{description}</p>
    </header>
    <section>
      {hiddenFields.map((field) => (
        <input type="hidden" name={field.name} value={field.value} />
      ))}
      <NotifyField id={`${id}-notify`} recipient={notifyRecipient} />
    </section>
    <footer>
      <button
        type="button"
        class="btn"
        data-variant="outline"
        onclick="this.closest('dialog').close()"
      >
        Cancel
      </button>
      <button type="submit" class="btn">
        Approve
      </button>
    </footer>
    <button
      type="button"
      class="btn"
      data-variant="ghost"
      data-size="icon-sm"
      aria-label="Close dialog"
      onclick="this.closest('dialog').close()"
    >
      <X class="size-4" />
    </button>
  </form>
</dialog>
