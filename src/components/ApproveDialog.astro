---
import DialogShell from '@/components/DialogShell.astro';
import NotifyField from '@/components/NotifyField.astro';

interface Props {
  id: string;
  title: string;
  description: string;
  formAction: string;
  notifyRecipient: 'author' | 'owner' | 'claimant';
  hiddenFields?: { name: string; value: string | number }[];
}

const {
  id,
  title,
  description,
  formAction,
  notifyRecipient,
  hiddenFields = [],
} = Astro.props;
---

<DialogShell
  id={id}
  title={title}
  description={description}
  formAction={formAction}
  submitLabel="Approve"
>
  {hiddenFields.map((field) => (
    <input type="hidden" name={field.name} value={field.value} />
  ))}
  <NotifyField id={`${id}-notify`} recipient={notifyRecipient} />
</DialogShell>
