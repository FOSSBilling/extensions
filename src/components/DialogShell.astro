---
import { X } from '@lucide/astro';

interface Props {
  id: string;
  title?: string;
  description: string;
  // Omitted for placeholder actions that are filled in client-side before
  // the dialog opens (see the admin queue dialogs).
  formAction?: string;
  submitLabel: string;
  submitVariant?: 'destructive';
  // When set, the submit button stays disabled until the user types this
  // exact string — type-to-confirm for destructive actions.
  typeToConfirm?: string;
}

const {
  id,
  title,
  description,
  formAction,
  submitLabel,
  submitVariant,
  typeToConfirm,
} = Astro.props;
---

<dialog
  id={id}
  class="dialog"
  aria-labelledby={`${id}-title`}
  aria-describedby={`${id}-description`}
  onclick="if (arguments[0].target === this) this.close()"
  onclose={
    typeToConfirm
      ? "this.querySelector('form').reset(); this.querySelector('[data-confirm-submit]').disabled = true;"
      : "this.querySelector('form').reset()"
  }
>
  <form method="POST" action={formAction}>
    <header>
      <h2 id={`${id}-title`}>
        <slot name="title">{title}</slot>
      </h2>
      <p id={`${id}-description`}>{description}</p>
    </header>
    <section class="space-y-4">
      {typeToConfirm && (
        <div class="field">
          <label for={`${id}-confirm`}>
            Type <strong>{typeToConfirm}</strong> to confirm
          </label>
          <input
            class="input"
            type="text"
            id={`${id}-confirm`}
            autocomplete="off"
            oninput={`this.closest('form').querySelector('[data-confirm-submit]').disabled = this.value !== ${JSON.stringify(typeToConfirm)}`}
          />
        </div>
      )}
      <slot />
    </section>
    <footer>
      <button
        type="button"
        class="btn"
        data-variant="outline"
        onclick="this.closest('dialog').close()"
      >
        Cancel
      </button>
      <button
        type="submit"
        class="btn"
        data-variant={submitVariant}
        data-confirm-submit={typeToConfirm ? '' : undefined}
        disabled={typeToConfirm ? true : undefined}
      >
        {submitLabel}
      </button>
    </footer>
    <slot name="extra" />
    <button
      type="button"
      class="btn"
      data-variant="ghost"
      data-size="icon-sm"
      aria-label="Close dialog"
      onclick="this.closest('dialog').close()"
    >
      <X class="size-4" />
    </button>
  </form>
</dialog>
